        <p class="mt-[1.3em] text-[20px] leading-[1.3] font-medium tracking-[-0.06em] text-[#6b6b6b] max-[950px]:text-[18px] max-[950px]:tracking-[-0.04em]">Neque porro quisquam est qui dolorem ipsum quia dolor sit amet consectetur adipiscing.</p>
      </div>
      <Panel variant="phone" class="mb-[165px] max-[950px]:mb-[96px]">
        <Video class="media media--phone" src={v('H1BTGZZAe2hDJhMXUlAAgRKMwQ')} width=702 height=1532 label="Placeholder video showing a person choosing an option, tapping a fallback, and reviewing more pending items" />
      </Panel>

      <div class="story__text story__text--narrow w-[470px] max-w-full mb-[60px] max-[950px]:w-full max-[950px]:mb-[32px]" data-reveal data-fade>
        <p class="text-[20px] leading-[1.3] font-medium tracking-[-0.06em] text-[#6b6b6b] max-[950px]:text-[18px] max-[950px]:tracking-[-0.04em]">Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam.</p>
      </div>
      <Panel>
        <img class="media" src="/assets/images/ni1rS3onvwMrh70qAhqrp564LSM.png" alt="Placeholder dashboard screenshot with a detail panel open: a response has been submitted and is ready for approval" width="3456" height="2112" loading="lazy" decoding="async" />
      </Panel>
