    <!-- ============ 1. intro ============ -->
    <section class="slide min-h-svh grid place-items-center pt-[120px] px-[24px] pb-[80px] text-center max-[950px]:pt-[110px] max-[950px]:px-[20px] max-[950px]:pb-[60px]">
