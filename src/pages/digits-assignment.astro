    <!-- fixed bottom UI -->
    <a
      class="da-figma fixed left-[20px] bottom-[20px] z-50 inline-flex items-center gap-[10px] px-[20px] py-[8px] rounded-[40px] bg-forest text-white text-[16px] leading-[1.5] font-semibold tracking-[-0.02em] whitespace-nowrap [transition:background_0.2s_ease,transform_0.35s_var(--ease-spring)] hover:bg-[#166f51] active:[transform:scale(0.97)] max-[950px]:left-[16px] max-[950px]:bottom-[16px] max-[950px]:text-[14px] max-[950px]:px-[16px]"
