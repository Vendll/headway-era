<script>
  // Fade out + shrink blocks as they leave the viewport (Framer "exit" effect), fade back in when they return.
  // The appear animation itself comes from the global data-reveal helper; this only toggles `.is-out`.
  const els = document.querySelectorAll<HTMLElement>('[data-fade]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (els.length && !reduce && 'IntersectionObserver' in window) {
    const steps = Array.from({ length: 11 }, (_, i) => i / 10);
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          const rootH = en.rootBounds?.height ?? window.innerHeight;
          // "out" once less than 35% of the block (or of the viewport, for tall blocks) is visible
          const need = Math.min(en.boundingClientRect.height, rootH) * 0.35;
          en.target.classList.toggle('is-out', en.intersectionRect.height < need);
        }
      },
      { threshold: steps, rootMargin: '-12% 0px -8% 0px' },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ---------------------------------------------------------------------------
     Everything else on this page is Tailwind utilities on the markup. What is
     left here cannot be expressed as a utility — see the note on each rule.
     ------------------------------------------------------------------------ */

  /* exit animation (pairs with the global [data-reveal] appear).
     :global() + JS-toggled state classes (.is-in / .is-out), and it has to stay
     unlayered so it wins over the unlayered global `[data-reveal].is-in`. */
  .da :global([data-fade].is-in.is-out) {
    opacity: 0;
    transform: translateY(-14px) scale(0.96);
    transition-duration: 0.5s;
  }

  /* global.css has an UNLAYERED `main :is(img, video, iframe) { border-radius:
     var(--radius-md) }`. Utilities live in @layer utilities and always lose to
     unlayered CSS, so a `rounded-[14px]` class here would be overridden. */
  .da-logo img { border-radius: 14px; }

  /* :global() into <HandArrow>. Its own scoped `.hand-arrow { color: inherit }`
     is likewise unlayered, so a `text-[#111]` utility on the component would
     lose to it — the whole rule stays as CSS to keep the arrow's colour,
     placement and flip exact. */
  .slide__inner--tricky :global(.tricky__arrow) {
    position: absolute;
    left: -276px;
    top: -82px;
    width: 62px;
    color: #111;
    transform: scaleY(-1);
  }

  @media (max-width: 1199px) {
    .slide__inner--tricky :global(.tricky__arrow) { left: -166px; top: -86px; }
  }
  @media (max-width: 949px) {
    .da-logo img { border-radius: 11px; }
    .slide__inner--tricky :global(.tricky__arrow) { display: none; }
  }
</style>
