import HandArrow from '@/components/HandArrow.astro';
import Video from '@/components/Video.astro';
import Panel from '@/components/digits-assignment/Panel.astro';

const figma = '#';
const v = (id: string) => `/assets/videos/${id}.mp4`;
---

<BaseLayout
