---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowTag from '@/components/ArrowTag.astro';
import TypewriterLink from '@/components/TypewriterLink.astro';
import Marquee from '@/components/Marquee.astro';
import WhereIveBeen from '@/components/WhereIveBeen.astro';
import Footer from '@/components/Footer.astro';
import Video from '@/components/Video.astro';
import { site } from '@/data/site';
import { projects, testimonials } from '@/data/projects';

/** Hero headline: the last word cycles. Longest word reserves the slot width. */
const heroWords = ['megmozgat.', 'összeköt.', 'előrevisz.', 'megkülönböztet.', 'megmarad.'];
const heroWidest = heroWords.reduce((a, b) => (b.length > a.length ? b : a));
---

<BaseLayout title={site.title} theme="light" header="default" headerPosition="fixed" headerAssemble>
  <!-- ============ Hero ============ -->
  <section class="hero" id="hero">
    <div class="hero__bg" aria-hidden="true">
      <span class="hero__wash hero__wash--a"></span>
      <span class="hero__wash hero__wash--b"></span>
      <span class="hero__wash hero__wash--c"></span>
      <span class="hero__wash hero__wash--d"></span>
    </div>
    <div class="hero__text">
      <h1 class="hero__h" data-reveal>
        Strat&eacute;gia, m&aacute;rka, kommunik&aacute;ci&oacute;.<br />Partners&eacute;g, amely<br />
        <em class="rot" data-rotate={heroWords.join('|')}>
          <span class="visually-hidden">{heroWords[0]}</span>
          <span class="rot__sizer" aria-hidden="true">{heroWidest}</span>
          <span class="rot__live" aria-hidden="true"><span class="rot__text" /><span class="rot__caret" /></span>
        </em>
      </h1>
    </div>
  </section>

  <!-- ============ Blue "know more" panel (widens as it scrolls in) ============ -->
  <section class="fun" id="fun" data-fun>
    <div class="fun__inner">
      <div class="fun__tag"><ArrowTag side="right" variant="white">Lorem ipsum dolor<br />sit <em>amet elit</em></ArrowTag></div>
      <div class="fun__copy">
        <p class="fun__p" data-reveal>
          Sed <em>Placeholder,</em> lorem ipsum dolor, sit amet consectetur. Adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore. Enim ad minim veniam quis.
        </p>
        <p class="fun__p" data-reveal data-reveal-delay="0.1">
          Nostrud exercitation ullamco laboris. Nisi aliquip commodo consequat. Duis aute irure dolor in reprehenderit voluptate velit esse cillum dolore eu fugiat nulla pariatur sint.
        </p>
        <TypewriterLink class="fun__link" href="/about" text="About" />
      </div>
    </div>
  </section>

  <!-- ============ Projects (sticky stacking cards) ============ -->
  <section class="projects" id="projects">
    <div class="projects__head" id="title">
      <div class="projects__tag"><ArrowTag side="left" variant="dark">Lorem Ipsum<br /><em>dolorsit!!</em></ArrowTag></div>
      <h2 class="projects__h" data-reveal>Lor<em>emip</em><span class="projects__count">(05)</span></h2>
    </div>

    <div class="stack" data-stack>
      {
        projects.map((p, i) => (
          <article class="card" id={p.id} style={`--i:${i}`}>
            <a class="card__badge" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined} aria-label={`Project ${p.num}`}>
              {p.num}
            </a>
            <div class="card__info">
              <p class="card__year">{p.year}</p>
              <h3 class="card__title" set:html={p.title.replace('\n', '<br />')} />
              <p class="card__desc" set:html={p.description} />
              <div class="card__meta">
                <details class="acc" open>
                  <summary class="acc__label">Category</summary>
                  <p class="acc__value">{p.discipline}</p>
                </details>
                <details class="acc">
                  <summary class="acc__label">The Role</summary>
                  <p class="acc__value">{p.role}</p>
                </details>
                <details class="acc">
                  <summary class="acc__label">Duration</summary>
                  <p class="acc__value">{p.timeline}</p>
                </details>
              </div>
              <a class="btn card__cta" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
                Case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
              </a>
            </div>
            <div class:list={['card__media', `card__media--${p.media.fit ?? 'contain'}`]} style={`background:${p.mediaBg}`}>
              {p.media.type === 'video' ? <Video class="card__vid" src={p.media.src} label={p.media.alt} /> : <img src={p.media.src} alt={p.media.alt} loading="lazy" decoding="async" />}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ Testimonials (dark box) ============ -->
  <section class="testi theme-dark" id="testimonials">
    <h2 class="testi__h" data-reveal>Consectetur, adipiscing <em>elit</em><br />sed do eiusmod!</h2>
    <div class="testi__wrap">
      <div class="testi__side"><span class="testi__mark testi__mark--open" aria-hidden="true">“</span></div>
      <ul class="testi__list">
        {
          testimonials.map((t, i) => (
            <li class="testi__item" data-reveal data-reveal-delay={String(i * 0.05)}>
              <p class="testi__q">{t.quote}</p>
              <p class="testi__by">
                {t.role}
                <br />
                {t.name}
              </p>
            </li>
          ))
        }
      </ul>
      <div class="testi__side testi__side--end"><span class="testi__mark testi__mark--close" aria-hidden="true">”</span></div>
    </div>
  </section>

  <div class="theme-dark home-dark">
    <Marquee class="home-marquee" text="Lorem ipsum dolor, sit amet consectetur" href={site.linkedin} repeat={3} duration={22} />
    <WhereIveBeen />
    <Footer />
  </div>
</BaseLayout>

<script>
  // Blue panel: grows from ~72% to ~90% of the viewport width as it scrolls into view.
  const fun = document.querySelector<HTMLElement>('[data-fun]');
  if (fun) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const update = () => {
      const r = fun.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 while the panel's top is below 62% of the viewport, 1 once it reaches 22% (matches the Framer scroll section)
      const p = reduce ? 1 : clamp((vh * 0.62 - r.top) / (vh * 0.4));
      const eased = p * p * (3 - 2 * p);
      fun.style.setProperty('--fun-w', `${72 + eased * 18}%`);
    };
    update();
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 80px 24px 40px;
    text-align: center;
  }

  /* Soft brand washes so the hero is not an empty white field. Pure gradients -
     no images, no requests. Their centres sit well away from the middle of the
     screen, which keeps the headline over near-untinted background. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* clipping alone leaves a hard horizontal seam where the hero ends, which is
       visible as soon as you scroll - fade the layer out before that edge */
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 96%);
  }
  .hero__wash {
    position: absolute;
    inset: -20%; /* room to drift without exposing an edge */
    display: block;
    will-change: transform;
  }
  .hero__wash--a {
    background: radial-gradient(42% 40% at 18% 26%, rgba(247, 147, 29, 0.2), transparent 68%);
    animation: hero-drift-a 74s ease-in-out infinite alternate;
  }
  .hero__wash--b {
    background: radial-gradient(40% 38% at 84% 76%, rgba(247, 147, 29, 0.15), transparent 68%);
    animation: hero-drift-b 88s ease-in-out infinite alternate;
  }
  .hero__wash--c {
    background: radial-gradient(34% 32% at 80% 14%, rgba(23, 16, 230, 0.06), transparent 70%);
    animation: hero-drift-a 96s ease-in-out infinite alternate-reverse;
  }
  /* right-hand counterpart to --a. Deliberately not a mirror: sits lower, is
     taller than it is wide, and drifts on its own vector and clock. */
  .hero__wash--d {
    background: radial-gradient(34% 46% at 93% 47%, rgba(247, 147, 29, 0.17), transparent 66%);
    animation: hero-drift-c 81s ease-in-out infinite alternate;
  }
  @keyframes hero-drift-a {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(3%, 2%, 0); }
  }
  @keyframes hero-drift-b {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-3%, -2%, 0); }
  }
  @keyframes hero-drift-c {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-2%, 3.5%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__wash { animation: none; }
  }
  .hero__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 5vw, 92px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .hero__h em { color: var(--green); font-style: italic; }

  /* The rotating word reserves the width of the longest option via a hidden
     sizer, so the centred headline never reflows as the word changes. The live
     text is absolutely positioned over that slot and left-aligned, which is
     what puts the caret right after the last typed character. */
  /* the rotating word carries the logo colour */
  .hero__h .rot { position: relative; display: inline-block; text-align: center; color: var(--brand); }
  .hero__h .rot__sizer { visibility: hidden; padding-right: 0.14em; }
  .hero__h .rot__live { position: absolute; left: 0; right: 0; top: 0; white-space: nowrap; }
  .hero__h .rot__caret {
    display: inline-block;
    width: 0.055em;
    height: 0.62em;
    margin-left: 0.05em;
    background: currentColor;
    border-radius: 1px;
    animation: rot-blink 1s steps(1) infinite;
  }
  @keyframes rot-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__h .rot__caret { animation: none; }
  }
  /* ---------- blue panel ---------- */
  .fun {
    --fun-w: 72%;
    width: var(--fun-w);
    max-width: 100%;
    margin: 20px auto 0;
    border-radius: var(--r-xl);
    background: var(--blue);
    color: #fafafa;
    min-height: 1134px;
    display: grid;
    place-items: center;
    padding: 120px 24px;
    will-change: width;
  }
  .fun__inner { position: relative; width: min(683px, 100%); text-align: center; }
  .fun__tag { position: absolute; left: -170px; top: -150px; }
  .fun__tag :global(.atag__arrow) { color: #fafafa; }
  .fun__copy { display: flex; flex-direction: column; align-items: center; gap: 30px; }
  .fun__p {
    font-family: var(--font-display);
    font-size: clamp(30px, 2.45vw, 50px);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: #fafafa;
  }
  .fun__p em { font-style: italic; }
  .fun__link { color: #fafafa; margin-top: 30px; }

  /* ---------- projects ---------- */
  .projects { width: min(1450px, 100% - 2 * var(--gutter)); margin: 130px auto 0; }
  .projects__head { position: relative; display: flex; flex-direction: column; align-items: center; margin-bottom: 80px; padding-top: 0; }
  .projects__tag { position: absolute; right: 17%; top: -10px; z-index: 1; }
  .projects__tag :global(.atag__arrow) { color: var(--ink); }
  .projects__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(96px, 12.2vw, 250px);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--ink-2);
    position: relative;
    margin-top: 90px;
  }
  .projects__h em { font-style: italic; }
  .projects__count { font-family: var(--font-mono); font-size: 20px; letter-spacing: -0.05em; color: var(--blue); margin-left: 0.05em; vertical-align: baseline; display: inline-block; transform: translateY(-0.2em); }

  .stack { position: relative; width: min(1400px, 100%); margin-inline: auto; padding-top: 60px; }
  .card {
    position: sticky;
    top: 60px;
    display: grid;
    grid-template-columns: 490px 1fr;
    height: 756px;
    margin-bottom: 40px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-2);
  }
  .card:last-child { margin-bottom: 0; }
  .card__badge {
    position: absolute;
    top: -50px;
    right: calc(var(--i) * 60px);
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
    background: var(--blue);
    color: #f5f5f5;
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.05em;
    transition: background 0.2s ease;
  }
  .card__badge:hover { background: #2a23ff; }
  .card__info { position: relative; padding: 40px 30px 40px 30px; display: flex; flex-direction: column; }
  .card__year { font-family: var(--font-mono); font-size: 16px; letter-spacing: -0.04em; color: var(--muted); }
  .card__title { font-size: 24px; line-height: 1.2; font-weight: 400; letter-spacing: -0.02em; color: var(--ink); margin-top: 44px; }
  .card__desc { font-size: 16px; line-height: 1.3; color: var(--muted-2); margin-top: 20px; }
  .card__desc :global(strong) { font-weight: 600; color: var(--muted-2); }
  .card__meta { margin-top: 56px; display: flex; flex-direction: column; gap: 4px; }
  .acc__label {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-2);
    padding: 6px 0;
  }
  .acc__label::-webkit-details-marker { display: none; }
  .acc__label::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.3s var(--ease-spring);
  }
  .acc[open] .acc__label::after { transform: rotate(-135deg) translate(-2px, -1px); }
  .acc__value { font-size: 16px; line-height: 1.3; color: var(--muted-2); padding: 0 0 12px; animation: acc-in 0.4s var(--ease-spring); }
  @keyframes acc-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .card__cta { margin-top: auto; align-self: flex-start; }
  /* card is not overflow:hidden (the badge deliberately sits above it), so the media rounds its own outer corners */
  .card__media { position: relative; overflow: hidden; display: grid; place-items: center; border-radius: 0 var(--r-lg) var(--r-lg) 0; }
  .card__media--contain img, .card__media--contain :global(.card__vid) { width: 84%; height: auto; max-height: 90%; object-fit: contain; }
  .card__media--cover img, .card__media--cover :global(.card__vid) { width: 100%; height: 100%; object-fit: cover; }

  /* ---------- testimonials ---------- */
  .testi {
    width: min(1880px, 100% - 2 * 68px);
    margin: 300px auto 0;
    border-radius: var(--r-xl);
    background: #151515;
    color: #f5f5f5;
    padding: 130px 24px 120px;
    text-align: center;
  }
  .testi__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 7.8vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #f5f5f5;
  }
  .testi__h em { color: var(--green); font-style: italic; }
  .testi__wrap {
    position: relative;
    display: grid;
    grid-template-columns: 300px 500px 300px;
    justify-content: center;
    margin: 150px auto 0;
    text-align: left;
  }
  .testi__side { position: relative; }
  .testi__side .testi__mark { position: sticky; top: 38vh; }
  .testi__list { list-style: none; display: flex; flex-direction: column; gap: 100px; }
  .testi__q { font-size: 22px; line-height: 1.1; font-weight: 400; color: #e3e3e3; }
  .testi__by { font-size: 16px; line-height: 1.2; font-style: italic; font-weight: 300; color: #e3e3e3; margin-top: 60px; }
  .testi__mark {
    display: block;
    font-family: var(--font-display);
    font-size: 440px;
    line-height: 0.5;
    height: 0.5em;
    color: var(--green);
    pointer-events: none;
    padding-top: 0.1em;
  }
  .testi__mark--open { margin-left: 0; }
  .testi__mark--close { margin-left: 150px; margin-top: 0.12em; }

  .home-dark { background: #151515; color: #f5f5f5; }
  .home-marquee { padding: 40px 0 0; border-bottom: 1px solid #262626; }

  /* ---------- responsive ---------- */
  @media (max-width: 1499px) {
    .stack { width: 100%; }
    .card { grid-template-columns: 38% 1fr; height: auto; min-height: 640px; }
  }
  @media (max-width: 1199px) {
    .fun { --fun-w: 92%; }
    .fun__tag { left: 0; top: -150px; }
    .projects__tag { right: 8%; }
    .testi__wrap { grid-template-columns: minmax(0, 500px); }
    .testi__side { display: none; }
  }
  @media (max-width: 949px) {
    .hero__h { font-size: clamp(34px, 8.5vw, 60px); }
    .fun { min-height: 0; padding: 140px 24px 90px; margin-top: 0; }
    .fun__tag { position: static; margin-bottom: 40px; }
    .fun__p { font-size: 32px; }
    .projects { margin-top: 100px; }
    .projects__head { margin-bottom: 60px; }
    .projects__tag { position: static; align-self: flex-end; }
    .projects__h { font-size: clamp(72px, 18vw, 120px); margin-top: 10px; }
    .card { grid-template-columns: 1fr; position: relative; top: auto; min-height: 0; margin-bottom: 70px; }
    .card__badge { right: 0; }
    .card__media { aspect-ratio: 4 / 3; order: -1; border-radius: var(--r-lg) var(--r-lg) 0 0; }
    .card__cta { margin-top: 32px; }
    .testi { width: 100%; margin-top: 140px; padding: 90px 20px 90px; }
    .testi__wrap { margin-top: 70px; }
    .testi__list { gap: 60px; }
  }
</style>
