---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Services from '@/components/Services.astro';
import Footer from '@/components/Footer.astro';
import Video from '@/components/Video.astro';
import { site } from '@/data/site';
import { projects, testimonials } from '@/data/projects';

/** Hero headline: the last word types itself. The longest word reserves the slot width. */
const heroWords = ['megmozgat.', 'összeköt.', 'előrevisz.', 'megkülönböztet.', 'megmarad.'];
const heroWidest = heroWords.reduce((a, b) => (b.length > a.length ? b : a));

/* Media is absolutely positioned inside the card's media box: percentage
   insets resolve against the box even where percentage heights would not. */
const mediaFitClass = {
  contain: 'absolute inset-[7%] w-[86%] h-[86%] object-contain',
  cover: 'absolute inset-0 w-full h-full object-cover',
};
const count = String(projects.length).padStart(2, '0');
---

<BaseLayout title={site.title} theme="light" header="default" headerPosition="fixed" headerAssemble>
  <!-- ============ Hero ============ -->
  <section class="hero wrap min-h-[100svh] flex flex-col justify-center pt-[calc(var(--header-h)+32px)] pb-16" id="hero">
    <h1
      class="hero__h font-semibold text-[clamp(32px,9.5vw,60px)] md:text-[clamp(40px,5.6vw,88px)] leading-[0.98] tracking-[-0.04em] text-ink max-w-[14em]"
      data-reveal
    >
      Stratégia, márka, kommunikáció. Partnerség, amely{' '}
      <em class="rot relative inline-block text-brand not-italic" data-rotate={heroWords.join('|')}>
        <span class="visually-hidden">{heroWords[0]}</span>
        <span class="rot__sizer invisible pr-[0.1em]" aria-hidden="true">{heroWidest}</span>
        <span class="rot__live absolute left-0 right-0 top-0 whitespace-nowrap" aria-hidden="true"><span class="rot__text" /><span
            class="rot__caret inline-block w-[0.05em] h-[0.72em] ml-[0.05em] bg-current rounded-[1px] align-[-0.06em]"
          /></span>
      </em>
    </h1>

    <div class="hero__row mt-[clamp(40px,5vw,72px)] grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-8 items-end" data-reveal data-reveal-delay="0.15">
      <p class="md:col-span-7 lg:col-span-6 text-[clamp(17px,1.35vw,20px)] leading-[1.5] text-ink-soft max-w-[32em]">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.
      </p>
      <div class="md:col-span-5 lg:col-start-9 lg:col-span-4 flex flex-wrap gap-3 md:justify-end">
        <a class="btn btn--brand btn--lg" href={site.cta.href}>{site.cta.label}</a>
        <a class="btn btn--ghost btn--lg" href="#munkaink">Ipsum dolor</a>
      </div>
    </div>
  </section>

  <!-- ============ Manifesto panel (widens as it scrolls in) ============ -->
  <section
    class="fun mx-auto rounded-xl bg-ink text-light px-[clamp(24px,6vw,110px)] py-[clamp(72px,9vw,150px)] will-change-[width]"
    id="rolunk"
    data-fun
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-10">
      <p class="lg:col-span-12 text-[14px] text-[#9a9a9a]">Rólunk</p>
      <h2
        class="lg:col-span-10 font-semibold text-[clamp(28px,3.2vw,52px)] leading-[1.1] tracking-[-0.03em] text-light"
        data-reveal
      >
        Sed placeholder, lorem ipsum dolor, sit amet consectetur. Adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore. Enim ad minim veniam quis.
      </h2>
      <p class="lg:col-start-7 lg:col-span-5 text-[17px] leading-[1.55] text-[#c4c4c4] max-w-[34em]" data-reveal data-reveal-delay="0.1">
        Nostrud exercitation ullamco laboris. Nisi aliquip commodo consequat. Duis aute irure dolor in reprehenderit voluptate velit esse cillum dolore eu fugiat nulla pariatur sint.
      </p>
    </div>
  </section>

  <!-- ============ Services ============ -->
  <Services />

  <!-- ============ Work (image-first sticky stack) ============ -->
  <section class="projects wrap pb-[clamp(96px,11vw,160px)]" id="munkaink">
    <div class="projects__head flex items-baseline gap-4 mb-[clamp(40px,5vw,72px)]">
      <h2 class="font-semibold text-[clamp(36px,4.2vw,64px)] leading-[1] tracking-[-0.035em] text-fg" data-reveal>Munkáink</h2>
      <span class="font-mono text-[15px] text-fg-muted" aria-label={`${projects.length} projekt`}>({count})</span>
    </div>

    <div class="stack relative" data-stack>
      {
        projects.map((p) => {
          const fit = p.media.fit ?? 'contain';
          const mediaCls = mediaFitClass[fit];
          return (
            <article
              class="card relative sticky top-[calc(var(--header-h)+20px)] flex flex-col h-[min(76vh,720px)] mb-6 last:mb-0 overflow-hidden rounded-lg border border-line bg-bg-2 max-[950px]:top-[calc(var(--header-h)+12px)] max-[950px]:h-auto max-[950px]:mb-4"
              id={p.id}
            >
              <header class="card__head flex items-center gap-x-6 gap-y-1 px-[clamp(18px,2vw,28px)] py-4 border-b border-line text-[14px] leading-[1.3]">
                <span class="font-mono text-fg-muted">{p.num}</span>
                <span class="font-semibold text-ink">{p.client}</span>
                <span class="text-fg-muted-2 max-[641px]:hidden">{p.service}</span>
                <span class="text-fg-muted-2 max-[641px]:hidden">{p.year}</span>
                <span class="ml-auto inline-flex items-center gap-2 font-medium text-ink">
                  Lorem ipsum
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
                </span>
              </header>

              <div
                class:list={[
                  'card__media',
                  fit === 'cover' && 'card__media--cover',
                  'relative flex-1 min-h-0 overflow-hidden max-[950px]:aspect-[4/3] max-[950px]:flex-none',
                ]}
                style={`background:${p.mediaBg}`}
              >
                {p.media.type === 'video' ? <Video class={`card__vid ${mediaCls}`} src={p.media.src} label={p.media.alt} /> : <img class={mediaCls} src={p.media.src} alt={p.media.alt} loading="lazy" decoding="async" />}
              </div>

              <p class="card__result px-[clamp(18px,2vw,28px)] py-[clamp(16px,1.6vw,22px)] border-t border-line font-semibold text-[clamp(20px,1.9vw,28px)] leading-[1.2] tracking-[-0.03em] text-ink tabular-nums" data-countup>
                {p.result}
              </p>

              {/* the whole card is the link; it sits above the content but carries the accessible name */}
              <a
                class="card__link absolute inset-0 z-[1]"
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener' : undefined}
                aria-label={`${p.client}: lorem ipsum`}
              />
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- ============ Client quotes (dark) ============ -->
  <section class="testi theme-dark bg-dark text-light" id="ugyfeleink">
    <div class="wrap pt-[clamp(96px,11vw,160px)] pb-[clamp(32px,4vw,56px)]">
      <h2 class="font-semibold text-[clamp(36px,4.2vw,64px)] leading-[1] tracking-[-0.035em] text-light" data-reveal>Ügyfeleink</h2>
      <ul class="testi__list list-none mt-[clamp(40px,5vw,72px)] grid md:grid-cols-2 gap-x-16">
        {
          testimonials.map((t) => (
            <li class="testi__item py-10 md:py-12 border-t border-rule flex flex-col">
              <blockquote class="font-medium text-[clamp(19px,1.5vw,23px)] leading-[1.45] tracking-[-0.015em] text-[#e6e6e6]">„{t.quote}”</blockquote>
              <p class="mt-7 text-[15px] leading-[1.4] font-medium text-light">{t.name}</p>
              <p class="text-[14px] leading-[1.4] text-fg-muted">{t.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Manifesto panel: --fun-t scrubs 0 → 1 as the panel enters the viewport;
  // the CSS below turns it into a width between --fun-from and --fun-to.
  const fun = document.querySelector<HTMLElement>('[data-fun]');
  if (fun) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    let last = -1;
    const update = () => {
      const r = fun.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 while the panel's top is below 62% of the viewport, 1 once it reaches 22%
      const p = reduce ? 1 : clamp((vh * 0.62 - r.top) / (vh * 0.4));
      const eased = p * p * (3 - 2 * p);
      if (eased === last) return;
      last = eased;
      fun.style.setProperty('--fun-t', eased.toFixed(4));
    };
    update();
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
  }
</script>

<style>
  /* What stays here: keyframes, rules that read the JS-driven --fun-t, and
     hover rules that cross from the stretched link to its siblings. */

  /* The typed word reserves the width of the longest option via a hidden
     sizer, so the headline never reflows as the word changes. The live text is
     absolutely positioned over that slot, left-aligned, which puts the caret
     right after the last typed character. */
  .hero__h .rot__caret { animation: rot-blink 1s steps(1) infinite; }
  @keyframes rot-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__h .rot__caret { animation: none; }
  }

  /* ---------- manifesto panel ---------- */
  /* --fun-t is written by the scroll script above (defaults to 1 so the panel
     is full width if the script never runs). from/to are per breakpoint. */
  .fun {
    --fun-t: 1;
    --fun-from: 74%;
    --fun-to: 92%;
    width: calc(var(--fun-from) + (var(--fun-to) - var(--fun-from)) * var(--fun-t));
  }
  @media (max-width: 1199px) {
    .fun { --fun-from: 88%; --fun-to: 94%; }
  }
  /* phones: no room to widen, so the panel grows from inset-with-corners to
     edge-to-edge-and-square instead - same scrub, different axis */
  @media (max-width: 949px) {
    .fun {
      --fun-from: calc(100% - 2 * var(--gutter));
      --fun-to: 100%;
      border-radius: calc(var(--radius-xl) * (1 - var(--fun-t)));
    }
  }

  /* ---------- work ---------- */
  /* a cover image fills the box edge to edge, so it must not inherit the
     site-wide rounded-media rule (unlayered, so a utility would lose to it) */
  .card__media--cover :is(img, video) { border-radius: 0; }
  /* hover answers the stretched link: the media eases in, the label turns brand */
  .card__media :is(img, video) { transition: transform 0.6s var(--ease-spring); }
  .card:has(.card__link:hover) .card__media :is(img, video) { transform: scale(1.02); }
  .card:has(.card__link:hover) .card__head > span:last-child,
  .card:has(.card__link:focus-visible) .card__head > span:last-child { color: var(--brand); }
  .card:has(.card__link:focus-visible) { outline: 2px solid var(--brand); outline-offset: 3px; }
  .card__link:focus-visible { outline: none; }
  @media (prefers-reduced-motion: reduce) {
    .card__media :is(img, video) { transition: none; }
  }
</style>
