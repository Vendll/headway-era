---
/**
 * /experimental — the playful "desk": one viewport, no scrolling. Eight stickers
 * (photos, videos, wordmarks) sit on the top arc of a big invisible wheel exactly
 * like the Framer "Circular loop" (spoke radius 740px, 22.5° apart), each one
 * links somewhere and can be dragged around.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Video from '@/components/Video.astro';
import DeskItem from '@/components/experimental/DeskItem.astro';
import { site } from '@/data/site';

const figma = '#';
const resumeCard = '#';
---

<BaseLayout title={site.title} theme="dark" header="default" scrollTop={false} noSmooth>
  <section
    class="desk relative h-[100svh] overflow-hidden bg-dark text-light [--s:120px] [--r:min(740px,36vw)] [--cy:calc(39vh_+_var(--r))] max-[1200px]:[--r:36vw] max-[950px]:[--s:84px] max-[950px]:[--r:35vw] max-[950px]:[--cy:48svh]"
    aria-label="Experimental — dolor sit amet"
  >
    <h1 class="visually-hidden">Experimental</h1>

    <div class="wheel absolute inset-0 origin-[50%_63%] max-[950px]:origin-[50%_50%]" data-wheel>
      <!-- top of the wheel, then clockwise: 0 · 22.5 · 45 · 67.5 · 90, and counter-clockwise: -22.5 · -45 · -67.5 -->
      <DeskItem href="/about" angle={0} label="About Placeholder" class="item-me [--media-pos:48%_33%]">
        <img src="/assets/images/8j0h9B6goi93N6Xo9tc31Yu0s.png" alt="Placeholder portrait" width="1118" height="1424" draggable="false" decoding="async" />
      </DeskItem>

      <DeskItem angle={22.5} label="Company Name" class="item-uxterps [--box-radius:20px]">
        <img src="/assets/images/r6wUw0Ci3FoQzX9eM3JnMrYg0gc.png" alt="Placeholder wordmark" width="716" height="716" draggable="false" decoding="async" />
      </DeskItem>

      <DeskItem href={figma} angle={45} label="Project Five case study — sample file" class="item-speakaboo">
        <Video src="/assets/videos/laKMYyfD2HgZMwExcVuyNDkc.mp4" label="Project Five sample video" fit="cover" />
      </DeskItem>

      <DeskItem href="/about" angle={67.5} label="Lorem, ipsum?" class="item-travel">
        <img src="/assets/images/Hn0hPj9VSe9iwziXWsFQWz8lPM.png" alt="Placeholder image" width="1080" height="1350" draggable="false" decoding="async" />
      </DeskItem>

      <DeskItem href="/gemini" angle={90} label="Project Three case study" class="item-gemini [--box-bg:#040404]">
        <Video src="/assets/videos/vQb0V0gKxO9GbN6pa99fT8PAz8.mp4" label="Project Three" />
      </DeskItem>

      <DeskItem href="/flex-d" angle={-22.5} label="Project Four case study" class="item-flexd">
        <Video src="/assets/videos/u7vs3PAHrtkGtLr1wYqtZFz4Zw.mp4" label="Project Four" fit="cover" />
      </DeskItem>

      <DeskItem href="/superreply" angle={-45} label="Project One case study" class="item-superreply">
        <img src="/assets/images/Tuozz24SV11yI4r8Sa4hXpOWNc.png" alt="Placeholder product screenshot" width="1080" height="1080" draggable="false" decoding="async" />
      </DeskItem>

      <DeskItem href={resumeCard} angle={-67.5} label="Resume" class="item-resume">
        <img src="/assets/images/wGIJ4KRtXhASBS2RrIaOCzs4mE.png" alt="Placeholder image" width="250" height="250" draggable="false" decoding="async" />
      </DeskItem>
    </div>

    <p class="desk__hint absolute left-1/2 bottom-[30px] z-[2] font-display font-normal text-[24px] leading-[0.9] tracking-[-0.02em] text-muted-2 whitespace-nowrap pointer-events-none max-[950px]:text-[20px] max-[950px]:bottom-[24px] max-[641px]:bottom-[64px]" data-reveal="fade" data-reveal-delay="0.6">Dolor sit <em class="italic">amet</em>!</p>
  </section>
</BaseLayout>

<script>
  // Every sticker is draggable (Pointer Events). The drag offset lives in --dx/--dy
  // so the wheel rotation stays intact; a click that never moved follows the link.
  const items = document.querySelectorAll<HTMLElement>('[data-desk-item]');
  let zTop = 10;
  const THRESHOLD = 4;

  for (const el of items) {
    let pointer: number | null = null;
    let startX = 0;
    let startY = 0;
    let baseX = 0;
    let baseY = 0;
    let moved = false;

    const read = (name: string) => parseFloat(el.style.getPropertyValue(name)) || 0;

    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || pointer !== null) return;
      pointer = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      baseX = read('--dx');
      baseY = read('--dy');
      moved = false;
      el.style.zIndex = String(++zTop);
      el.setPointerCapture(e.pointerId);
    });

    el.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pointer) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (!moved) {
        if (Math.hypot(dx, dy) < THRESHOLD) return;
        moved = true;
        el.classList.add('is-dragging');
      }
      el.style.setProperty('--dx', `${baseX + dx}px`);
      el.style.setProperty('--dy', `${baseY + dy}px`);
    });

    const end = (e: PointerEvent) => {
      if (e.pointerId !== pointer) return;
      pointer = null;
      el.classList.remove('is-dragging');
      if (el.hasPointerCapture(e.pointerId)) el.releasePointerCapture(e.pointerId);
    };
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    el.addEventListener('lostpointercapture', () => {
      pointer = null;
      el.classList.remove('is-dragging');
    });

    // a drag must not navigate
    el.addEventListener('click', (e) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
      }
    });
    el.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  /* ---------------------------------------------------------------------------
     Everything else on this page is Tailwind utilities on the markup. What is
     left here cannot be expressed as a utility — see the note on each rule.
     ------------------------------------------------------------------------ */

  /* @keyframes and the animation that uses it. */
  .wheel { animation: wheel-in 1.4s var(--ease-spring) both; }
  @keyframes wheel-in {
    from { opacity: 0.6; transform: translateY(350px) scale(0.6); }
    to { opacity: 1; transform: none; }
  }

  /* :global() into the <video> slotted through <DeskItem>. It has to beat
     DeskItem's own (unlayered) `.desk-item__box :global(video)` rule, which
     utilities in @layer utilities never can. */
  .desk .item-gemini :global(video) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: contain;
  }

  /* the caption fades in on its own; these keep the shared, unlayered
     [data-reveal] helper in global.css from shifting it off-centre. */
  .desk__hint,
  .desk__hint[data-reveal],
  .desk__hint[data-reveal].is-in { transform: translateX(-50%); }
</style>
