---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import ArrowTag from '@/components/ArrowTag.astro';
import Section from '@/components/cs/Section.astro';
import Row from '@/components/cs/Row.astro';
import Inner from '@/components/cs/Inner.astro';
import Dark from '@/components/cs/Dark.astro';
import TldrItem from '@/components/cs/TldrItem.astro';
import Statement from '@/components/cs/Statement.astro';
import Figure from '@/components/cs/Figure.astro';
import Grid from '@/components/cs/Grid.astro';

const toc = [
  { id: 'introduction', label: 'Section One' },
  { id: 'tl-dr', label: 'Section Two' },
  { id: 'primary-research', label: 'Section Three' },
  { id: 'sec-research', label: 'Section Four' },
  { id: 'problem-statement', label: 'Section Five' },
  { id: 'core-flows', label: 'Section Six' },
  { id: 'design-system', label: 'Section Seven' },
  { id: 'future-enhancements', label: 'Section Eight' },
  { id: 'reflection', label: 'Section Nine' },
];

const problemHeading =
  "Lorem ipsum dolor sit amet consectetur adipiscing elit. Sed do eiusmod <span class='accent'>3 tempor incididunt labore</span> et dolore magna aliqua ut enim ad minim veniam.";

const facts = [
