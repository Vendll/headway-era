    <div class="slate-tldr__tag flex justify-end pr-[180px] mb-[10px] max-[1200px]:pr-[60px] max-[950px]:pr-[16px]">
      <ArrowTag side="left" variant="dark" arrowColor="var(--blue)" arrowWidth={80}>Lorem<br /><em class="text-[#f5f5f5]">Ipsum</em></ArrowTag>
    </div>
    <Dark>
      <TldrItem label="Label Four" heading={problemHeading}>
        <ul class="facts" role="list">
