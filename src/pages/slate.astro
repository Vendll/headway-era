            facts.map((f, i) => (
              <li class="fact" data-reveal="up" data-reveal-delay={String(i * 0.08)}>
                <img class="fact__icon w-[26px] h-[26px] flex-none mt-[3px]" src="/assets/images/qWwGHHBgQHfzM38Kd3z2GMbmsQ.png" alt="" width="512" height="512" loading="lazy" decoding="async" />
                <p class="fact__text" set:html={f.html} />
              </li>
            ))
