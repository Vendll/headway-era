  </Section>

  <!-- ============ Reflection ============ -->
  <Section id="reflection">
    <Dark wide class="reflect" style="padding:50px">
      <p class="cs-label mb-[26px]" data-reveal="fade">Section Nine</p>
      <div class="reflect__grid grid grid-cols-[292px_minmax(0,630px)] gap-x-[48px] max-[950px]:grid-cols-[1fr] max-[950px]:gap-y-[20px]">
        <h3 class="cs-h cs-h--lg reflect__h text-[#f5f5f5]" data-reveal="up">Lorem ipsum dolor</h3>
        <div class="cs-body reflect__body" data-reveal="up">
          <p class="text-[16px] leading-[1.3]">Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua, ut enim ad minim veniam quis nostrud exercitation ullamco laboris. Nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu.</p>
          <p class="text-[16px] leading-[1.3]">Fugiat nulla pariatur excepteur sint occaecat, cupidatat non proident sunt in culpa qui officia. Deserunt mollit anim id est laborum, sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium. Totam rem aperiam eaque ipsa quae ab illo.</p>
        </div>
      </div>
    </Dark>
    <p class="mobile-note hidden mt-[40px] text-center text-[14px] font-light tracking-[-0.02em] text-muted-2 max-[950px]:block">Note: Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt.</p>
  </Section>
</CaseStudyLayout>

<style>
  /* Everything below is KEPT deliberately. Two reasons recur:
     (a) CASCADE — Tailwind ships its utilities inside `@layer utilities`, while the
         `.cs-*` primitives in CaseStudyLayout's `<style is:global>
@layer components {  ` are unlayered.
           Unlayered author CSS beats layered CSS whatever the specificity, so a
           utility cannot override `.cs-hero`, `.cs-figure`, `.cs-card`, `.cs-body p`,
           `.cs-body li`, `.cs-body ul`, `.cs-body strong` or `main :is(img, video)`.
       (b) API — `:global()` reaching into a child component (ArrowTag, TldrItem,
           Statement) that exposes no class hook for the element being styled. */

    /* ---------- hero: yellow box, dashboard overflowing the bottom edge ----------
       (a) display/min-height fight .cs-hero; max-width fights .cs-hero > *. */
    .slate-hero {
      display: block;
      position: relative;
      background: var(--yellow);
      height: 726px;
      min-height: 0;
      overflow: hidden;
    }
    .slate-hero img {
      position: absolute;
      left: 50%;
      top: 175px;
      width: 810px;
      max-width: 90%;
      transform: translateX(-50%);
    }

    /* ---------- TL;DR ----------
       (b) ArrowTag renders `.tag-box` itself and only forwards `class` to its wrapper;
       TldrItem renders `.tldr__grid` / `.tldr__h` and forwards `class` to `.tldr`. */
    .slate-tldr__tag :global(.tag-box) { line-height: 0.85; }
    .slate-tldr :global(.tldr__grid) { grid-template-columns: 380px minmax(0, 1fr); }
    .slate-tldr :global(.tldr__h) { font-size: 20px; }

    /* (a) list-style/padding/margin fight `.cs-body ul`; `.fact` margin fights
       `.cs-body li`; `.fact__text` size/tracking/colour fight `.cs-body p` and
       `.cs-dark .cs-body p`. The `strong`s arrive via set:html, so they carry no
       class of their own. */
    .slate-tldr .facts {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .slate-tldr .facts .fact {
      display: flex;
      align-items: flex-start;
      gap: 24px;
      margin: 0;
      padding: 32px 24px;
      background: #1f1f1f;
      border-radius: 8px;
    }
    .slate-tldr .facts .fact .fact__text {
      font-size: 14px;
      line-height: 1.3;
      font-weight: 300;
      letter-spacing: -0.01em;
      color: #969696;
      margin: 0;
    }
    .slate-tldr .facts .fact .fact__text :global(strong) { font-weight: 500; color: #f5f5f5; }

    /* ---------- Whyser figure: two overlapping screenshots ----------
       (a) `.whyser__box` display/padding fight `.cs-figure`; `.whyser__shot`
       border-radius fights the unlayered `main :is(img, video, iframe)` rule, and
       its 949px width override has to outrank the base rule kept here.
       The per-shot left/top offsets moved to utilities on the images. */
    .whyser__box {
      display: block;
      padding: 0;
      aspect-ratio: 1120 / 474;
      overflow: hidden;
    }
    .whyser__shot {
      position: absolute;
      width: 69.6%;
      height: auto;
      border-radius: 6px;
      box-shadow: 0 6px 30px rgba(0, 0, 0, 0.08);
      background: #fff;
    }

    /* ---------- Competitive analysis cards ----------
       (a) `.comp__card` background fights `.cs-card--outline`, its 640px padding
       fights `.cs-card`, and the `strong`s fight `.cs-body strong`. */
    .comp__card {
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 24px;
      background: #fcfcfc;
    }
    .comp .comp__body :global(strong) { font-weight: 600; color: var(--ink-2); }

    /* ---------- Problem statement: full content width ----------
       (b) Statement owns `.statement` / `.statement__text`; (a) its own scoped
       `width: 1008px` is unlayered, so `w-full` could not win. */
    .slate :global(.slate-statement) { width: 100%; }
    .slate :global(.slate-statement .statement__text) { max-width: 1000px; }

    /* ---------- responsive ---------- */
    @media (max-width: 1199px) {
      .slate-hero { height: auto; aspect-ratio: 1120 / 726; }
      .slate-hero img { top: 24%; width: 72%; max-width: none; }
      .slate-tldr :global(.tldr__grid) { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); }
    }
    @media (max-width: 949px) {
      .slate-tldr :global(.tldr__grid) { grid-template-columns: 1fr; }
      .slate-tldr .facts .fact { padding: 20px; gap: 16px; }
      .whyser__box { aspect-ratio: 1120 / 560; }
      .whyser__shot { width: 78%; }
    }
    @media (max-width: 640px) {
      .slate-hero img { width: 84%; top: 22%; }
      .comp__card { gap: 20px; padding: 20px; }
    }
}
</style>
