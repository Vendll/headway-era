---
import CaseStudyLayout from '@/layouts/CaseStudyLayout.astro';
import ArrowTag from '@/components/ArrowTag.astro';
import Section from '@/components/cs/Section.astro';
import Row from '@/components/cs/Row.astro';
import Inner from '@/components/cs/Inner.astro';
import Dark from '@/components/cs/Dark.astro';
import TldrItem from '@/components/cs/TldrItem.astro';
import Statement from '@/components/cs/Statement.astro';
import Figure from '@/components/cs/Figure.astro';
import Grid from '@/components/cs/Grid.astro';
import Card from '@/components/cs/Card.astro';
import Stat from '@/components/cs/Stat.astro';
import Note from '@/components/superreply/Note.astro';
import Cursor from '@/components/superreply/Cursor.astro';
import Dashboard from '@/components/superreply/Dashboard.astro';

const toc = [
  { id: 'introduction', label: 'Section One' },
  { id: 'tldr', label: 'Section Two' },
  { id: 'preview', label: 'Section Three' },
  { id: 'user-research', label: 'Section Four' },
  { id: 'problem-statement', label: 'Section Five' },
  { id: 'core-flows', label: 'Section Six' },
  { id: 'brand-identity', label: 'Section Seven' },
  { id: 'impact', label: 'Section Nine' },
  { id: 'key-learnings', label: 'Section Ten' },
];

const groups = [
  {
    num: '01',
    title: 'Group One',
    points: ['Consectetur adipiscing elit sed eiusmod.', 'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua veniam quis nostrud.'],
  },
  {
    num: '02',
    title: 'Group Two<br />Placeholder',
    points: ['Excepteur sint occaecat, cupidatat non proident.', "Sunt in culpa qui officia deserunt mollit anim laborum."],
  },
  {
    num: '03',
    title: 'Group Three / Sub<br />Group Label',
    points: ['Voluptatem accusantium doloremque.', 'Sed ut perspiciatis unde, omnis iste natus, error sit voluptatem accusantium doloremque.'],
  },
];

const learnings = [
  { title: 'Adipiscing Elit ≠<br />Eiusmod Tempor', body: 'Lorem ipsum dolor sit amet consectetur adipiscing, elit sed, do eiusmod tempor incididunt labore.' },
  { title: 'Ipsum Dolor Consectetur', body: 'Ut enim ad minim 5 veniam quis nostrud, exercitation ullamco laboris nisi ut aliquip ex ea commodo.' },
  { title: 'Tempor Incididunt Labore Dolore', body: 'Duis aute irure dolor in reprehenderit voluptate velit esse cillum dolore eu fugiat nulla.' },
];

const stepShot = '/assets/images/djJdc6k2i5Ime1kmzF32WltW4.png';
const stepAlt =
  'Placeholder product screenshot';

/* shared utilities for the fixed-layout figure containers (.sr-fig) */
const figBase = 'relative w-full bg-bg-2 rounded-lg';
/* one "Step #n" figure: sticky card that un-sticks and pads out below 1200px */
const stepBase =
  'sticky top-[60px] h-[761px] bg-bg-2 rounded-lg overflow-hidden max-[1200px]:relative max-[1200px]:top-auto max-[1200px]:h-auto max-[1200px]:pt-[100px] max-[1200px]:px-[24px] max-[1200px]:pb-[40px] max-[950px]:pt-[80px] max-[950px]:px-[16px] max-[950px]:pb-[24px]';
const stepHeading =
  'absolute top-[30px] left-[40px] font-display font-normal text-[48px] leading-[53px] tracking-[-0.02em] text-ink max-[1200px]:top-[24px] max-[1200px]:left-[24px] max-[950px]:text-[36px] max-[950px]:leading-[1]';
/* `rounded-[6px]!` / `rounded-[8px]!`: global.css has an unlayered
   `main :is(img, video, iframe) { border-radius: var(--radius-md) }` which outranks
   the (layered) utilities, so the per-image radius has to be important. */
const stepImg =
  'absolute top-[134px] w-[752px] h-auto rounded-[6px]! [box-shadow:0_2px_24px_rgba(0,0,0,0.06)] max-[1200px]:relative max-[1200px]:top-auto max-[1200px]:left-auto! max-[1200px]:w-full max-[1200px]:max-w-[752px] max-[1200px]:mx-auto max-[1200px]:block';
/* one box in the "where was the gap?" diagram */
const gapBox = 'rounded-sm grid place-items-center text-[#f5f5f5] text-[16px] leading-[1.6] font-medium tracking-[-0.02em] text-center';
const gapLink = 'block w-[2px] h-[16px] mx-auto [border-left:2px_dotted_rgba(141,1,255,0.8)]';
/* the 880px inner text column above each flow figure */
const flowText = 'mt-[80px] max-[950px]:mt-[56px]';
---

<CaseStudyLayout
  accent="#8D01FF"
  eyebrow="Project One"
  title="Lorem ipsum <em>dolor sit</em> amet consectetur adipiscing elit sed do eiusmod tempor."
  description="Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor."
  tags="Category One, Category Two, Category Three, Category Four"
  year="2024"
  toc={toc}
  class="superreply"
>
  <!-- ============ Hero ============ -->
  <div
    slot="hero"
    class="sr-hero relative w-full h-[clamp(420px,72vh,727px)] bg-purple overflow-hidden rounded-lg mb-[40px] max-[1200px]:h-auto max-[1200px]:aspect-[1120/727]"
    data-reveal="up"
  >
    <img
      class="absolute left-[50%] bottom-0 h-[89%] w-auto max-w-none [transform:translateX(-50%)] max-[1200px]:h-auto max-[1200px]:w-[89%] max-[1200px]:max-w-[89%] max-[641px]:w-[94%] max-[641px]:max-w-[94%]"
      src="/assets/images/gAtztWfqOBOUmmIsslCnlYYMK4.png"
      alt="Placeholder product screenshot"
      width="1564"
      height="906"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="sr-body">
    <!-- ============ Introduction ============ -->
    <Section id="introduction" label="Section One" inset>
      <Row label="Lorem ipsum dolor?">
        <p>Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore</p>
