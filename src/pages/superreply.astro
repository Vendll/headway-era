          'sr-fig sr-fig--onboard',
          figBase,
          'mt-[40px] h-[640px] max-[1200px]:h-auto max-[1200px]:py-[60px] max-[1200px]:px-[24px] max-[641px]:py-[24px] max-[641px]:px-[16px]',
