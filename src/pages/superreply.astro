        <p class="sr-groups-h text-[16px] leading-[1.4] font-medium tracking-[-0.02em] text-ink mt-[60px] max-[950px]:mt-[40px]" data-reveal="fade">Lorem ipsum:</p>
        <Grid cols={3} gap={16} class="sr-groups mt-[18px]" min={240}>
          {
            groups.map((g, i) => (
              <Card variant="dark" title={g.title} num={g.num} data-reveal-delay={String(i * 0.06)}>
                <ul>
                  {g.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </Card>
            ))
