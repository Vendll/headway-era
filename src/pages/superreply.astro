        src="/assets/videos/ThKe0cQVVPaMiAS4dDq2xMPaHMs.mp4"
        alt="Placeholder product screen recording"
        containerWidth={1080}
        pad="80px 0"
        width={918}
        radius={8}
        border
        class="sr-preview__fig"
        mediaClass="bg-[#fafafa] aspect-[3440/2160]"
      />
    </Section>

    <!-- ============ User research ============ -->
