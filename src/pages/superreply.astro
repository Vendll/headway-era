<style>
  /* Everything below is deliberately NOT a utility: each rule either reaches into a
     child component's internals (no prop to hang a class on), or has to outrank
     unlayered CSS that the utilities layer would lose to, or is driven by a JS
     custom property. Everything else now lives on the markup as Tailwind classes. */

  /* `strong` is authored inside slot content / set:html, so it cannot carry a class. */
  .sr-body :global(.cs-body strong) { font-weight: 600; }

  /* ---------- TL;DR ---------- */
  /* ArrowTag internals: the box has no class prop, and `.atag .atag__arrow`
     (unlayered, 0,2,0) would beat a utility on the arrow. */
  .sr-tldr__tag :global(.tag-box) {
    width: 128px;
    text-align: center;
    line-height: 1;
    letter-spacing: -0.03em;
    padding: 5px 0;
  }
  .sr-tldr__tag :global(.atag__arrow) { margin-top: 22px; }
  /* `.cs-dark { width: 1008px }` is unlayered global CSS — a `w-[1080px]` utility loses to it. */
  .sr-body :global(.sr-dark) { width: 1080px; }
  /* TldrItem internals (heading/body are set:html + slot content). */
  .sr-body :global(.sr-dark .tldr__h .accent) { color: var(--purple-2); }
  .sr-body :global(.sr-dark .tldr__body li) { margin: 0.2em 0; }
  .sr-body :global(.sr-dark .tldr__body ul) { margin-top: 1em; }

  /* ---------- user research ---------- */
  /* Card internals: no prop reaches .cs-card__main / __head / __num, and
     `.cs-card { padding: 24px }` is unlayered. */
  .sr-body :global(.sr-groups .cs-card) { min-height: 253px; }
  .sr-body :global(.sr-groups .cs-card__main) { justify-content: space-between; }
  .sr-body :global(.sr-groups .cs-card__head) { margin-bottom: 24px; }
  .sr-body :global(.sr-groups .cs-card__num) { opacity: 0.5; }

  /* ---------- problem statement: full content width ---------- */
  /* `.statement { width: 1008px }` is unlayered (Statement.astro), so it beats `w-full`. */
  .sr-body :global(.sr-statement) { width: 100%; }

  /* ---------- automations table ---------- */
  /* ::before with `content` has no utility equivalent. */
  .sr-table__lead::before {
    content: '';
    position: absolute;
    left: -3px;
    top: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8d01ff;
  }

  /* ---------- impact ---------- */
  /* Stat internals; `.stat { gap: 22px }` and `.cs-card`/`.stat__label` are unlayered. */
  .sr-body :global(.sr-impact__grid .stat) {
    justify-content: center;
    gap: 36px;
    min-height: 330px;
    padding: 50px 40px;
  }
  .sr-body :global(.sr-impact__grid .stat__label) { min-width: 326px; justify-content: center; }

  /* ---------- key learnings ---------- */
  /* `.cs-dark { padding: 50px 50px 80px }` and `.cs-card { padding: 24px }` are unlayered. */
  .sr-body :global(.sr-learn) { padding: 50px; }
  .sr-body :global(.sr-learn__grid .cs-card) { min-height: 210px; padding: 20px; }
  .sr-body :global(.sr-learn__grid .cs-card__main) { justify-content: space-between; }
  .sr-body :global(.sr-learn__grid .cs-card__head) { margin-bottom: 24px; }
  .sr-body :global(.sr-learn__grid .cs-card__body p) { color: #e3e3e3; }

  /* ---------- responsive ---------- */
  /* 1200–1499px: the content column is narrower than the 1120px these fixed-layout figures were designed for,
     so scale them (layout-affecting `zoom`, set from the column width by the script below). */
  @media (min-width: 1200px) and (max-width: 1499px) {
    .sr-fig--onboard, .sr-fig--dash, .sr-fig--templates, .sr-step, .sr-fig--table { zoom: var(--fig-zoom, 1); }
  }
  /* The two Cursor SVGs are positioned by utilities on their `class` prop, but hiding
     them has to stay here: `.sr-cursor { display: block }` (Cursor.astro) is unlayered
     and outranks a `hidden` utility. */
  @media (max-width: 1199px) {
    .sr-fig :global(.sr-fig__cursor) { display: none; }
  }
  @media (max-width: 949px) {
    .sr-body :global(.sr-groups .cs-card) { min-height: 0; }
    .sr-gap :global(.sr-gap__cursor) { display: none; }
    .sr-body :global(.sr-impact__grid .stat) { min-height: 0; padding: 32px 16px; gap: 24px; }
    .sr-body :global(.sr-impact__grid .stat__label) { min-width: 0; }
    .sr-body :global(.sr-learn) { padding: 32px 24px 40px; }
    .sr-body :global(.sr-learn__grid .cs-card) { min-height: 0; }
  }
  @media (max-width: 640px) {
    .sr-tldr__tag :global(.atag__arrow) { width: 80px; margin-top: 16px; }
  }
</style>

<script>
  // Fixed-layout figures are designed for a 1120px column; scale them when the column is narrower.
  const body = document.querySelector<HTMLElement>('.cs__body');
  if (body) {
    const apply = () => {
      const cs = getComputedStyle(body);
      const inner = body.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      body.style.setProperty('--fig-zoom', String(Math.min(1, Math.max(0.5, inner / 1120))));
    };
    apply();
    new ResizeObserver(apply).observe(body);
  }
</script>
