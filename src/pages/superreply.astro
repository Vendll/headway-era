            class="w-full h-auto"
            src="/assets/images/HbQr9uUX1NFmMc28MLI48fAB8I.png"
            alt="Placeholder product screenshot"
            width="3024"
            height="1900"
            loading="lazy"
            decoding="async"
          />
        </div>
        <Note top={304} left={825} line={72} width={175}>
          <p><strong>Lorem Ipsum Dolor</strong></p>
          <ul>
            <li>Sed do eiusmod tempor incididunt labore.</li>
            <li>Consectetur adipiscing elit sed do eiusmod.</li>
          </ul>
        </Note>
      </div>

      <!-- Dashboard -->
      <Inner class={`sr-flow__text ${flowText}`}>
        <h3 class="cs-h sr-flow__h mb-[14px]" data-reveal="up">Adipiscing elit eiusmod</h3>
        <p class="cs-p" data-reveal="up">
          Lorem ipsum dolor sit amet consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore. Magna aliqua ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis. Duis aute "irure dolor" in reprehenderit voluptate velit esse cillum dolore eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa.
        </p>
