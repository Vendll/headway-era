<script>
  // Pinned horizontal scroller — pin the section and slide the card track sideways as the page scrolls.
  const wrap = document.querySelector<HTMLElement>('[data-hscroll]');
  const sticky = wrap?.querySelector<HTMLElement>('[data-hscroll-sticky]');
  const track = wrap?.querySelector<HTMLElement>('[data-hscroll-track]');

  if (wrap && sticky && track) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const small = window.matchMedia('(max-width: 949px)');
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    /** scroll distance (px) per px of horizontal travel — the live section runs ~300vh */
    const PACE = 1.5;
    let travel = 0;
    let range = 1;

    const isStatic = () => reduce.matches || small.matches;

    const measure = () => {
      if (isStatic()) {
        wrap.classList.add('is-static');
        wrap.style.height = '';
        track.style.transform = '';
        return;
      }
      wrap.classList.remove('is-static');
      track.style.transform = '';
      travel = Math.max(0, track.getBoundingClientRect().width - sticky.clientWidth);
      const vh = window.innerHeight;
      range = Math.max(1, Math.round(travel * PACE));
      wrap.style.height = `${vh + range}px`;
      update();
    };

    const update = () => {
      if (isStatic()) return;
      const p = clamp(-wrap.getBoundingClientRect().top / range);
      track.style.transform = `translate3d(${-Math.round(p * travel)}px,0,0)`;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    measure();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measure);
    reduce.addEventListener('change', measure);
    small.addEventListener('change', measure);
    // re-measure once the web fonts / images have settled (card widths are fixed, but be safe)
    window.addEventListener('load', measure, { once: true });
  }
</script>

<style>
  /* ---------- shared bits ---------- */
  .flexd-h2 {
    font-size: 24px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* ---------- hero ---------- */
  .flexd-hero {
    background: #6026ff;
    min-height: 680px;
    padding: 40px;
  }
  .flexd-hero__img { width: 78.6%; max-width: 880px; height: auto; }

  /* ---------- design focus: pinned horizontal scroller ---------- */
  .focus { --focus-inset: 220px; }
  .focus__wrap { position: relative; min-height: 100vh; margin-top: -38px; }
  .focus__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    padding-top: min(128px, 12vh);
  }
  .focus__track {
    display: flex;
    gap: 8px;
    width: max-content;
    padding-left: var(--focus-inset);
    padding-right: 40px;
    margin-top: min(116px, 10vh);
    will-change: transform;
  }
  .focus__mascot {
    position: absolute;
    right: 30px;
    bottom: 18vh;
    width: 84px;
    height: auto;
    pointer-events: none;
    animation: flexi-bob 2.6s ease-in-out infinite alternate;
    transform-origin: 50% 90%;
  }
  @keyframes flexi-bob {
    from { transform: translateY(0) rotate(-2deg); }
    to { transform: translateY(-14px) rotate(3deg); }
  }

  /* static fallback: reduced motion / small screens → native horizontal strip */
  .focus__wrap.is-static { min-height: 0; height: auto !important; }
  .focus__wrap.is-static .focus__sticky { position: static; height: auto; overflow: visible; padding-top: 0; }
  .focus__wrap.is-static .focus__track {
    width: auto;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 0 12px;
    margin-top: 40px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .focus__wrap.is-static .focus__track > :global(*) { scroll-snap-align: start; }
  .focus__wrap.is-static .focus__mascot { position: static; width: 64px; margin: 24px 0 0 auto; }

  /* ---------- preview: sticky note row + stacking posters ---------- */
  .snap { position: relative; }
  .snap__note {
    position: sticky;
    top: 60px;
    z-index: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding: 0 48px 0 50px;
    margin-top: 70px;
  }
  .snap__hint {
    max-width: 310px;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--muted-2);
  }
  .snap__tag { margin-top: -22px; }
  .posters { position: relative; margin-top: 110px; padding-bottom: 20px; }
  .poster {
    position: sticky;
    top: clamp(80px, 19vh, 180px);
    z-index: 1;
    width: 996px;
    max-width: 100%;
    margin: 0 auto 60px;
    background: #151515;
  }
  .poster:last-child { margin-bottom: 0; }
  .poster img { width: 100%; height: auto; display: block; }

  /* ---------- prototype ---------- */
  .proto {
    margin-top: 38px;
    background: var(--bg-2);
    padding: 88px 24px;
    display: grid;
    place-items: center;
    border-radius: var(--r-lg);
  }
  .proto__phone {
    width: 214px;
    height: 464px;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
  }
  .proto :global(.proto__video) { width: 100%; height: 100%; object-fit: cover; }

  /* ---------- impact ---------- */
  .impact :global(.impact__grid) { margin-top: 56px; }
  .impact__center { display: flex; justify-content: center; margin-top: 110px; }

  /* ---------- challenges ---------- */
  .tricky {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 40px;
    background: #1b1b1b;
    color: #fff;
    min-height: 630px;
    padding: 64px 70px 70px 50px;
    margin-top: 38px;
    overflow: hidden;
    border-radius: var(--r-lg);
  }
  .tricky__title {
    font-family: var(--font-champ);
    font-weight: 700;
    font-size: 54px;
    line-height: 1.08;
    letter-spacing: 0;
    color: #f8f5ff;
  }
  .tricky__title { position: relative; display: inline-block; }
  .tricky__sticker {
    position: absolute;
    left: 1.5em;
    top: -0.3em;
    width: 0.5em;
    height: auto;
    transform: rotate(-70deg);
    pointer-events: none;
  }
  .tricky__cards { display: flex; gap: 16px; align-items: flex-start; }
  .tricky__col { display: flex; flex-direction: column; gap: 16px; width: 270px; }
  .tricky__col--2 { margin-top: 14px; }

  /* ---------- figma embed ---------- */
  .figma {
    margin-top: 46px;
    background: var(--bg-2);
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    border-radius: var(--r-lg);
  }
  .figma__frame {
    display: block;
    width: 100%;
    max-width: 1080px;
    height: auto;
    aspect-ratio: 1080 / 650;
    border-radius: var(--r-md);
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #fff;
  }
  .figma :global(.figma__btn) { height: 52px; padding: 0 20px; }

  /* ---------- reflection ---------- */
  :global(.learn) { margin-top: 52px; }
  .learn__card {
    background: var(--bg-2);
    padding: 22px 20px 24px;
    border-radius: var(--r-md);
    min-height: 210px;
  }
  .learn__card p {
    font-size: 14px;
    line-height: 1.55;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  .learn__card strong { font-weight: 600; color: var(--ink); }

  /* ---------- responsive ---------- */
  @media (max-width: 1499px) {
    .focus { --focus-inset: 120px; }
  }
  @media (max-width: 1199px) {
    .flexd-hero { min-height: clamp(360px, 52vw, 680px); padding: 24px; }
    .flexd-hero__img { width: 90%; }
    .focus { --focus-inset: 24px; }
    .snap__note { padding: 0; }
    .tricky { grid-template-columns: 1fr; padding: 40px 32px 48px; min-height: 0; }
    .tricky__cards { flex-wrap: wrap; }
  }
  @media (max-width: 949px) {
    .focus__wrap { margin-top: 0; }
    .snap__note { position: static; flex-direction: column; margin-top: 40px; }
    .snap__tag { margin-top: 20px; align-self: flex-end; }
    .posters { margin-top: 48px; }
    .poster { position: relative; top: auto; margin-bottom: 24px; }
    .proto { padding: 48px 16px; }
    .impact__center { margin-top: 70px; }
    .tricky__title { font-size: clamp(36px, 10vw, 54px); }
    .tricky__cards { flex-direction: column; gap: 16px; }
    .tricky__col { width: 100%; }
    .tricky__col--2 { margin-top: 0; }
    .tricky :global(.trick) { --tilt: 0deg; }
  }
  @media (max-width: 640px) {
    .flexd-h2 { font-size: 21px; }
    .tricky { padding: 32px 20px 40px; }
    .figma { padding: 12px; }
    .learn__card { min-height: 0; }
  }
</style>
