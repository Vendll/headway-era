---
import { experience, site } from '@/data/site';
import HandArrow from './HandArrow.astro';
---

<section class="where" id="where">
  <div class="where__head">
    <p class="where__note" data-reveal>Lorem ipsum dolor sit <strong>amet consectetur<br />adipiscing elit</strong>, sed eiusmod</p>
    <div class="where__title" data-reveal data-reveal-delay="0.1">
      <HandArrow class="where__arrow" width={130} />
      <h2 class="where__h"><em>Lorem</em><br />ipsum sit</h2>
    </div>
  </div>

  <ul class="where__list">
    {
      experience.map((e, i) => (
        <li class="where__row" data-reveal data-reveal-delay={String(i * 0.06)}>
          <h3 class="where__company" set:html={e.company} />
          <p class="where__role" set:html={e.role} />
          <p class="where__when">{e.when}</p>
        </li>
      ))
    }
  </ul>

  <div class="where__cta" data-reveal>
    <a class="btn btn--lg" href={site.resumeView} target="_blank" rel="noopener">
      View Resume
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 19h14"/></svg>
    </a>
  </div>
</section>

<style>
  .where {
    width: min(1200px, 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding: 110px 0 120px;
    color: var(--fg);
  }
  .where__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 60px;
  }
  .where__note { font-size: 16px; font-weight: 300; line-height: 1.2; color: var(--fg-2); padding-top: 24px; }
  .where__note strong { font-weight: 600; }
  .where__title { display: flex; align-items: flex-start; gap: 16px; text-align: right; }
  .where__arrow { color: var(--blue); margin-top: 6px; }
  .where__h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 84px;
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--fg-2);
  }
  .where__h em { font-style: italic; }

  .where__list { list-style: none; }
  .where__row {
    display: grid;
    grid-template-columns: 460px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 34px 0 38px;
    border-bottom: 1px solid var(--rule);
  }
  .where__row:last-child { border-bottom: 0; }
  .where__company { font-family: var(--font-display); font-weight: 400; font-size: 42px; line-height: 0.8; letter-spacing: -0.02em; color: var(--fg-2); }
  .where__company :global(em) { font-style: italic; }
  .where__role, .where__when { font-size: 16px; font-weight: 300; letter-spacing: -0.02em; color: var(--fg-muted); line-height: 0.8; }
  .where__role :global(.accent) { color: var(--green); }
  .where__when { text-align: right; }
  .where__cta { display: flex; justify-content: center; margin-top: 60px; }

  @media (max-width: 949px) {
    .where { padding: 80px 0; }
    .where__head { flex-direction: column-reverse; gap: 32px; }
    .where__title { text-align: left; flex-direction: row-reverse; }
    .where__arrow { width: 90px; }
    .where__h { font-size: 56px; }
    .where__row { grid-template-columns: 1fr; gap: 10px; padding: 24px 0; }
    .where__company { font-size: 32px; }
    .where__when { text-align: left; }
  }
</style>
