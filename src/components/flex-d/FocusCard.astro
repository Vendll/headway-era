---
/**
 * One card of the Project Four "Lorem ipsum dolor sit?" horizontal scroller.
 *
 *   <FocusCard num="01" title="Lorem ipsum, dolor-sit amet consectetur" tone="dark"><p>…</p></FocusCard>
 *   <FocusCard tone="media" src="/assets/images/x.png" alt="…" pos="20% 50%" />
 */
interface Props {
  num?: string;
  title?: string;
  tone?: 'dark' | 'light' | 'media';
  src?: string;
  alt?: string;
  /** object-position for the media card */
  pos?: string;
  class?: string;
}
const { num, title, tone = 'dark', src, alt = '', pos, class: className } = Astro.props;

/* Tone/size utilities are picked here rather than stacked on the element: the
   media card overrides the base width and padding, and two competing utilities
   for one property would resolve by stylesheet order, not by markup order. */
const toneClass =
  tone === 'dark' ? 'bg-dark text-[#f5f5f5]'
  : tone === 'light' ? 'bg-light-2 text-muted-2'
  : 'bg-[#262626]';
const sizeClass =
  tone === 'media'
    ? 'w-[440px] p-0 max-[950px]:w-[min(70vw,360px)]'
    : 'w-[500px] p-[40px] max-[950px]:w-[min(80vw,420px)]';
---

<article
  class:list={[
    'fcard', `fcard--${tone}`,
    'flex-none h-[340px] flex flex-col overflow-hidden rounded-lg',
    sizeClass,
    toneClass,
    'max-[950px]:h-auto max-[950px]:min-h-[300px] max-[950px]:p-[28px]',
    className,
  ]}
>
  {
    tone === 'media' ? (
      <img class="fcard__img w-full h-full object-cover" src={src} alt={alt} loading="lazy" decoding="async" style={pos ? `object-position:${pos}` : undefined} />
    ) : (
      <>
        {num && <p class="fcard__num font-champ font-bold text-[30px] leading-none text-lime" aria-hidden="true">{num}</p>}
        <h3
          class:list={[
            'fcard__title text-[24px] leading-[1.15] font-medium tracking-[-0.02em] mt-[46px]',
            tone === 'light' && 'text-[#5b5b5b]',
            'max-[950px]:text-[21px] max-[950px]:mt-[32px]',
          ]}
        >
          {num && <span class="visually-hidden">{num} </span>}{title}
        </h3>
        <div class="fcard__body"><slot /></div>
      </>
    )
  }
</article>

<style>
  /* Slot content — the body copy is authored in the page, so these :global rules
     have no markup in this component to move onto. */
  .fcard__body :global(p) {
    font-size: 16px;
    line-height: 1.3;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-top: 22px;
    color: #e3e3e3;
  }
  .fcard--light .fcard__body :global(p) { color: #8c8c8c; }
</style>
