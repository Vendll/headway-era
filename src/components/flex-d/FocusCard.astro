---
/**
 * One card of the Project Four "Lorem ipsum dolor sit?" horizontal scroller.
 *
 *   <FocusCard num="01" title="Lorem ipsum, dolor-sit amet consectetur" tone="dark"><p>…</p></FocusCard>
 *   <FocusCard tone="media" src="/assets/images/x.png" alt="…" pos="20% 50%" />
 */
interface Props {
  num?: string;
  title?: string;
  tone?: 'dark' | 'light' | 'media';
  src?: string;
  alt?: string;
  /** object-position for the media card */
  pos?: string;
  class?: string;
}
const { num, title, tone = 'dark', src, alt = '', pos, class: className } = Astro.props;
---

<article class:list={['fcard', `fcard--${tone}`, className]}>
  {
    tone === 'media' ? (
      <img class="fcard__img" src={src} alt={alt} loading="lazy" decoding="async" style={pos ? `object-position:${pos}` : undefined} />
    ) : (
      <>
        {num && <p class="fcard__num" aria-hidden="true">{num}</p>}
        <h3 class="fcard__title">{num && <span class="visually-hidden">{num} </span>}{title}</h3>
        <div class="fcard__body"><slot /></div>
      </>
    )
  }
</article>

<style>
  .fcard {
    flex: none;
    width: 500px;
    height: 340px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-lg);
  }
  .fcard--dark { background: var(--dark); color: #f5f5f5; }
  .fcard--light { background: var(--light-2); color: var(--muted-2); }
  .fcard--media { width: 440px; background: #262626; padding: 0; }
  .fcard__img { width: 100%; height: 100%; object-fit: cover; }

  .fcard__num {
    font-family: var(--font-champ);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    color: var(--lime);
  }
  .fcard__title {
    font-size: 24px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-top: 46px;
  }
  .fcard--light .fcard__title { color: #5b5b5b; }
  .fcard__body :global(p) {
    font-size: 16px;
    line-height: 1.3;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-top: 22px;
    color: #e3e3e3;
  }
  .fcard--light .fcard__body :global(p) { color: #8c8c8c; }

  @media (max-width: 949px) {
    .fcard { width: min(80vw, 420px); height: auto; min-height: 300px; padding: 28px; }
    .fcard--media { width: min(70vw, 360px); min-height: 300px; }
    .fcard__title { font-size: 21px; margin-top: 32px; }
  }
</style>
