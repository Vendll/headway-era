---
/**
 * Colourful rounded card in the Project Four "Lorem ipsum dolor sit" block.
 *
 *   <ChallengeCard title="Lorem Ipsum Dolor<br>Sit Amet Elit<br>Consectetur" bg="#F0562F" tilt={-7}><p>…</p></ChallengeCard>
 */
interface Props {
  title: string; // HTML allowed (<br>)
  bg: string;
  /** rotation in degrees */
  tilt?: number;
  /** optional mascot image shown at the bottom of the card */
  mascot?: string;
  mascotAlt?: string;
  class?: string;
}
const { title, bg, tilt = 0, mascot, mascotAlt = '', class: className } = Astro.props;
---

<div
  class:list={[
    'trick', { 'trick--mascot': !!mascot },
    'rounded-md pt-[24px] px-[20px] text-white origin-center [transform:rotate(var(--tilt,0deg))]',
    mascot ? 'pb-0' : 'pb-[26px]',
    className,
  ]}
  style={`background:${bg};--tilt:${tilt}deg;`}
>
  <h3 class="trick__title font-champ font-bold text-[20px] leading-[1.12] tracking-[0] text-white" set:html={title} />
  <div class="trick__body"><slot /></div>
  {mascot && <img class="trick__mascot block w-[44%] mt-[14px] ml-[26%]" src={mascot} alt={mascotAlt} loading="lazy" decoding="async" />}
</div>

<style>
  /* Slot content — the body copy is authored in the page, so this :global rule
     has no markup in this component to move onto. */
  .trick__body :global(p) {
    font-size: 13px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.94);
    margin-top: 14px;
  }
</style>
