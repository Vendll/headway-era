---
/**
 * Site footer: one closing statement ("Beszéljünk."), the email as the
 * action, then a quiet bar with the wordmark, navigation and copyright.
 * Always dark - pages that end on a light section get the contrast step.
 */
import { site, nav } from '@/data/site';

interface Props {
  class?: string;
}
const { class: className, ...rest } = Astro.props;
---

<footer
  {...rest}
  class:list={['footer', 'theme-dark bg-dark text-light', className]}
  data-footer
  id="kapcsolat"
>
  <div class="wrap pt-[clamp(80px,10vw,140px)] pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-10 items-end">
      <div class="lg:col-span-8">
        <p
          class="font-semibold text-[clamp(56px,9.5vw,150px)] leading-[0.95] tracking-[-0.05em] text-light"
          data-reveal
        >
          Beszéljünk<span class="text-brand">.</span>
        </p>
      </div>
      <div class="lg:col-span-4 lg:pb-4">
        <a
          class="footer__mail inline-block font-medium text-[clamp(20px,1.9vw,28px)] leading-[1.1] tracking-[-0.02em] text-light underline decoration-1 underline-offset-[0.28em] decoration-[#5b5b5b] hover:decoration-brand transition-[text-decoration-color] duration-200"
          href={`mailto:${site.email}`}
        >
          {site.email}
        </a>
        <ul class="mt-6 flex gap-6 text-[15px] text-fg-muted">
          <li><a class="hover:text-light transition-colors duration-200" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a class="hover:text-light transition-colors duration-200" href={site.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bar mt-[clamp(72px,9vw,130px)] pt-8 border-t border-rule grid grid-cols-1 md:grid-cols-[auto_1fr_auto] items-center gap-x-12 gap-y-6 text-[14px] text-fg-muted">
      <a class="inline-flex items-center justify-self-start" href="/" aria-label={site.name}>
        <img class="footer__logo block h-7 w-auto" src={site.logo} alt="" width="556" height="88" loading="lazy" />
      </a>
      <nav class="flex flex-wrap gap-x-7 gap-y-2 md:justify-center" aria-label="Footer">
        {nav.map((n) => <a class="hover:text-light transition-colors duration-200" href={n.href}>{n.label}</a>)}
      </nav>
      <p class="md:text-right">{site.copyright}</p>
    </div>
  </div>
</footer>

<style>
  /* The wordmark must not inherit the site-wide rounded-media rule
     (`main :is(img, video, iframe)`): a 16px radius on a 28px-tall image
     rounds off the ascender of the "h" and the tail of the "y". That rule is
     unlayered, so a `rounded-none` utility would lose to it; this scoped rule
     outranks it. */
  .footer__logo { border-radius: 0; }
</style>
