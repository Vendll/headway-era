---
/** A link whose label types itself when scrolled into view, followed by a chevron. */
interface Props {
  href: string;
  text: string;
  class?: string;
  speed?: number;
}
const { href, text, class: className, speed = 100, ...rest } = Astro.props;
---

<a
  {...rest}
  class:list={['tw', 'inline-flex items-center gap-[2px] min-h-[1.4em] font-mono text-[16px] tracking-[-0.02em] text-inherit', className]}
  href={href}
  data-typewriter
  data-word={text}
  data-speed={speed}
>
  <span class="visually-hidden">{text}</span>
  <span class="tw__text whitespace-pre" aria-hidden="true"></span>
  <span class="tw__cursor inline-block w-[2px] h-[1em] rounded-sm bg-current" aria-hidden="true"></span>
  <svg class="tw__chev ml-[18px] opacity-0 [transition:opacity_0.4s_ease_0.2s]" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
</a>

<style>
  /* KEPT deliberately: the caret blink is a @keyframes animation, `.is-done` is a
     state class toggled by src/scripts/typewriter.ts, and the chevron's hover rule
     is a descendant-of-hover selector that swaps its transition as well. */
  .tw__cursor { animation: tw-blink 1s steps(1) infinite; }
  .tw.is-done .tw__cursor { animation-duration: 1.2s; }
  .tw.is-done .tw__chev { opacity: 1; }
  .tw:hover .tw__chev { transform: translateX(3px); transition: transform 0.3s var(--ease-spring); }
  @keyframes tw-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
</style>
