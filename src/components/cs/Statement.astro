---
/** Accent-coloured block with a mono label and a big quoted statement (problem statement). */
interface Props {
  label?: string;
  bg?: string;
  color?: string;
  class?: string;
  id?: string;
}
const { label = 'Section Label', bg = 'var(--accent-cs, var(--purple))', color = '#f5f5f5', class: className, id, ...rest } = Astro.props;
---

<div {...rest} id={id} class:list={['statement', 'w-[1008px] max-w-full mx-auto p-[50px] rounded-lg max-[950px]:p-[28px_24px]', className]} style={`background:${bg};color:${color}`} data-reveal="up" data-toc-section={id ? '' : undefined}>
  {label && <p class="statement__label font-mono text-[14px] font-light tracking-[-0.04em] leading-[1.2] opacity-95 mb-[32px]">{label}</p>}
  <p class="statement__text text-[28px] leading-[1.3] font-medium tracking-[-0.02em] max-[950px]:text-[22px]"><slot /></p>
</div>

<style>
  /* slot content (<strong> authored by the caller) */
  .statement__text :global(strong) { font-weight: 700; }
</style>
