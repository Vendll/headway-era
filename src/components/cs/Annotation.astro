---
/**
 * Small annotation placed on top of a Figure: a dotted leader line ending in a dot, with a note.
 * Position with percentages of the figure box. `side="right"` puts the text to the right of the line.
 *
 * <Annotation top="12%" left="72%" width={170} side="right">Lorem ipsum dolor sit amet…</Annotation>
 */
interface Props {
  top: string;
  left: string;
  /** leader line length in px */
  line?: number;
  /** text block width in px */
  width?: number;
  side?: 'left' | 'right';
  color?: string;
  class?: string;
  /** vertical leader (line goes down from the dot) */
  vertical?: boolean;
}
const { top, left, line = 120, width = 160, side = 'right', color = 'var(--accent-cs, var(--purple-2))', class: className, vertical = false, ...rest } = Astro.props;

/* flex-direction / align-items are emitted exclusively so the vertical variant keeps
   winning over the left variant, exactly as the old cascade did. */
const dir = vertical ? 'flex-col items-center' : side === 'left' ? 'flex-row-reverse items-start' : 'items-start';
const shift = side === 'left' ? '-translate-x-full' : '';

/* vertical: the line runs downwards from the dot instead of sideways */
const lineClass = vertical
  ? 'relative flex-none w-0 h-[var(--line)] m-0 border-l-2 border-dotted border-[color:var(--c)]'
  : 'relative flex-none w-[var(--line)] h-0 mt-[6px] border-t-2 border-dotted border-[color:var(--c)]';
---

<div
  {...rest}
  class:list={[
    'annot',
    `annot--${side}`,
    { 'annot--v': vertical },
    'absolute flex gap-[10px] z-[2] pointer-events-none',
    dir,
    shift,
    'max-[950px]:hidden',
    className,
  ]}
  style={`top:${top};left:${left};--line:${line}px;--w:${width}px;--c:${color}`}
>
  <span class:list={['annot__line', lineClass]} aria-hidden="true"></span>
  <div class="annot__text w-[var(--w)] text-[12px] leading-[1.25] font-normal tracking-[-0.01em] text-muted-2"><slot /></div>
</div>

<style>
  /* dots at both ends of the leader line — ::before/::after with `content` */
  .annot__line::before, .annot__line::after { content: ''; position: absolute; top: -4px; width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  .annot__line::before { left: -3px; }
  .annot__line::after { right: -3px; }
  .annot--v .annot__line::before { top: -3px; left: -4px; }
  .annot--v .annot__line::after { top: auto; bottom: -3px; left: -4px; }

  /* slotted content — owned by the caller's markup, so it stays as :global() CSS */
  .annot__text :global(ul) { list-style: disc; padding-left: 1.1em; margin-top: 4px; }
  .annot__text :global(strong) { display: block; font-weight: 500; color: #151515; margin-bottom: 4px; }
  .annot__text :global(p) { margin: 0; }
</style>
