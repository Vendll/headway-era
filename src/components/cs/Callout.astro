---
/** Soft rounded callout box (e.g. the blue "Lorem ipsum? Dolor." note on the Project Three page). */
interface Props {
  bg?: string;
  color?: string;
  border?: string;
  title?: string;
  class?: string;
  icon?: string;
}
const { bg = '#dce6ff', color = '#151515', border, title, class: className, icon, ...rest } = Astro.props;
---

<div {...rest} class:list={['callout', 'flex gap-[20px] p-[24px_30px] rounded-md', className]} style={`background:${bg};color:${color};${border ? `border:1px solid ${border};` : ''}`} data-reveal="up">
  {icon && <span class="callout__icon text-[22px] leading-none flex-none" aria-hidden="true">{icon}</span>}
  <div class="callout__main cs-body">
    {title && <p class="callout__title font-semibold tracking-[-0.02em] mb-[16px] text-inherit" set:html={title} />}
    <slot />
  </div>
</div>

<style>
  /* `.cs-body p { font-size: 16px }` (CaseStudyLayout, unlayered) outranks a
     `text-[18px]` utility, so the title size has to stay as CSS. */
  .callout__title { font-size: 18px; }

  /* slot content (<p>/<li>/<a> authored by the caller) — cannot carry utilities */
  .callout__main :global(p), .callout__main :global(li) { color: inherit; font-weight: 400; }
  .callout__main :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
