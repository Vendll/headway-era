---
/**
 * Impact statistic: dark pill label, huge serif value, small caption.
 * <Stat label="Lorem Ipsum" value="6 weeks" caption="Lorem ipsum dolor sit in <b>6 weeks</b>…" />
 */
interface Props {
  label: string;
  value: string;
  caption?: string;
  class?: string;
}
const { label, value, caption, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={['stat', 'flex flex-col items-center text-center gap-[22px]', className]} data-reveal>
  <span class="stat__label inline-flex items-center h-[51px] px-[30px] rounded-pill bg-dark text-light text-[24px] font-normal tracking-[-0.02em] max-[950px]:h-[44px] max-[950px]:px-[20px] max-[950px]:text-[18px]">{label}</span>
  <p class="stat__value font-display font-normal text-[86px] leading-[0.9] tracking-[-0.03em] text-ink max-[950px]:text-[60px]" set:html={value} />
  {caption && <p class="stat__caption text-[14px] leading-[1.3] font-light tracking-[-0.02em] text-muted-2 max-w-[400px]" set:html={caption} />}
</div>

<style>
  /* value/caption arrive via set:html, so their inline tags cannot carry utilities */
  .stat__value :global(em) { font-style: italic; }
  .stat__caption :global(b), .stat__caption :global(strong) { font-weight: 500; }
</style>
