---
/** Big serif quotation mark + quote + author (client testimonial). */
interface Props {
  author?: string;
  role?: string;
  color?: string;
  markColor?: string;
  class?: string;
}
const { author, role, color, markColor = 'var(--accent-cs, var(--purple))', class: className, ...rest } = Astro.props;
---

<blockquote {...rest} class:list={['quote', className]} style={color ? `color:${color}` : undefined} data-reveal="up">
  <span class="quote__mark" style={`color:${markColor}`} aria-hidden="true">“</span>
  <div class="quote__box">
    <p class="quote__text"><slot /></p>
    {(author || role) && (
      <footer class="quote__by">
        {author && <span>{author}</span>}
        {role && <span>{role}</span>}
      </footer>
    )}
  </div>
</blockquote>

<style>
  .quote { position: relative; margin: 0; padding: 50px 0 0 30px; }
  .quote__mark { position: absolute; left: 0; top: 0; font-family: var(--font-display); font-size: 200px; line-height: 0.7; }
  .quote__box { background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); padding: 40px 32px 40px 32px; margin-left: 12px; }
  .quote__text { font-size: 22px; line-height: 1.25; font-weight: 400; letter-spacing: -0.02em; color: var(--ink); }
  .quote__by { display: flex; flex-direction: column; gap: 2px; margin-top: 44px; font-size: 16px; color: var(--muted-2); }
</style>
