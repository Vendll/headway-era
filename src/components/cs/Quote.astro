---
/** Big serif quotation mark + quote + author (client testimonial). */
interface Props {
  author?: string;
  role?: string;
  color?: string;
  markColor?: string;
  class?: string;
}
const { author, role, color, markColor = 'var(--accent-cs, var(--purple))', class: className, ...rest } = Astro.props;
---

<blockquote {...rest} class:list={['quote', 'relative m-0 p-[50px_0_0_30px]', className]} style={color ? `color:${color}` : undefined} data-reveal="up">
  <span class="quote__mark absolute left-0 top-0 font-display text-[200px] leading-[0.7]" style={`color:${markColor}`} aria-hidden="true">“</span>
  <div class="quote__box bg-white border border-line rounded-md p-[40px_32px] ml-[12px]">
    <p class="quote__text text-[22px] leading-[1.25] font-normal tracking-[-0.02em] text-ink"><slot /></p>
    {(author || role) && (
      <footer class="quote__by flex flex-col gap-[2px] mt-[44px] text-[16px] text-muted-2">
        {author && <span>{author}</span>}
        {role && <span>{role}</span>}
      </footer>
    )}
  </div>
</blockquote>
