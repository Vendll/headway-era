---
/**
 * Project Three case study — one "Flow #n" block: mono label + heading + copy on the left,
 * a light grey box with the phone prototype video on the right.
 *
 * <Flow label="Flow #1" title="Lorem Ipsum" video="/assets/videos/x.mp4" radius={12} videoLabel="…">…copy…</Flow>
 */
import Video from '@/components/Video.astro';

interface Props {
  label: string;
  title: string;
  video: string;
  videoLabel?: string;
  /** border radius of the video inside the box */
  radius?: number;
  class?: string;
}
const { label, title, video, videoLabel, radius = 0, class: className } = Astro.props;
---

<div
  class:list={[
    'flow grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-[10px] items-start',
    '[.flow+&]:mt-[72px]',
    'max-[950px]:grid-cols-[1fr] max-[950px]:gap-[24px] max-[950px]:[.flow+&]:mt-[56px]',
    className,
  ]}
>
  <div class="flow__text pr-[120px] min-w-0 max-[1200px]:pr-[40px] max-[950px]:pr-0">
    <p class="cs-label mb-[24px]">{label}</p>
    <h3 class="flow__h text-[20px] leading-[1.3] font-medium tracking-[-0.02em] text-ink mb-[16px]">{title}</h3>
    <div class="flow__body cs-body"><slot /></div>
  </div>
  <div
    class="flow__media bg-bg-2 py-[30px] px-0 flex justify-center overflow-hidden max-[950px]:py-[20px] max-[950px]:px-[20px]"
    data-reveal
  >
    <Video
      class="flow__vid w-[448px] max-w-full h-auto max-[950px]:w-full"
      src={video}
      label={videoLabel}
      style={`border-radius:${radius}px`}
    />
  </div>
</div>

<style>
  /* Slot content — the copy is authored in the page, so these :global rules have
     no markup in this component to move onto. */
  .flow__body :global(p),
  .flow__body :global(li) {
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--muted-2);
  }
  .flow__body :global(strong) { font-weight: 600; }
  .flow__body :global(p + p),
  .flow__body :global(ul + p) { margin-top: 1.4em; }
  .flow__body :global(ul) { margin-top: 1.4em; padding-left: 1.3em; }
  .flow__body :global(ul.tight) { margin-top: 0; }
  .flow__body :global(li) { margin: 0; }
</style>
