---
/**
 * Top navigation bar: links left, centred wordmark, call to action right.
 *
 *   default – full bar (links + logo + CTA)
 *   minimal – logo only (standalone pages)
 */
import { site, nav } from '@/data/site';
import MobileNav from '@/components/MobileNav';
import Wordmark from '@/components/Wordmark.astro';

interface Props {
  variant?: 'default' | 'minimal';
  position?: 'fixed' | 'absolute';
  /** landing state: logo alone, bar assembles around it as the page scrolls */
  assemble?: boolean;
}
const { variant = 'default', position = 'fixed', assemble = false } = Astro.props;

/** current path, normalised so "/play.html", "/play/" and "/index.html" all match */
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/+$/, '$1') || '/';
/** hash links (all of the home nav) are never "current page" - the section they point at is unknown server-side */
const isActive = (href: string) => !href.includes('#') && (href.replace(/\/+$/, '') || '/') === path;
---

<header
  class:list={[
    'site-nav',
    `site-nav--${position}`,
    `site-nav--${variant}`,
    { 'site-nav--assemble': assemble },
    position === 'absolute' ? 'absolute' : 'fixed',
    'top-0 left-0 right-0 z-[60] h-[var(--header-h)]',
    'flex items-center justify-between gap-4',
    'px-[var(--gutter)]',
    'font-body text-[15px] max-[950px]:text-[14px] font-medium leading-[1.2] tracking-[-0.01em] text-fg',
  ]}
  data-header
  data-nav-assemble={assemble ? '' : undefined}
>
  {
    variant !== 'minimal' && (
      <div class="site-nav__burger hidden max-[641px]:block">
        <MobileNav client:load items={nav} cta={site.cta} activePath={path} />
      </div>
    )
  }

  {
    variant !== 'minimal' && (
      <nav
        class="site-nav__links flex items-center gap-[28px] max-[950px]:gap-5 max-[641px]:hidden"
        aria-label="Primary"
      >
        {nav.map((n) => (
          <a
            class:list={[
              'site-nav__link',
              { 'is-active': isActive(n.href) },
              'whitespace-nowrap transition-[color] duration-200 ease-[ease] hover:text-fg',
              isActive(n.href) ? 'text-fg' : 'text-fg-muted-2',
            ]}
            href={n.href}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))}
      </nav>
    )
  }

  {/* absolutely centred so the mark stays put however long the link list gets */}
  <a
    class="site-nav__logo absolute left-1/2 top-1/2 [transform:translate(-50%,-50%)] flex items-center"
    href="/"
    aria-label={site.name}
  >
    {/* the mark is 6.32:1 - at its 40px landing size it needs 253px, so max-width
        must stay above that or it clamps the width and distorts it. On the home
        page it is inline SVG so nav.ts can morph the letters (see Wordmark). */}
    {
      assemble ? (
        <Wordmark class="block h-7 w-auto max-w-[min(340px,45vw)] max-[950px]:h-6 max-[641px]:h-7 max-[641px]:max-w-[62vw]" />
      ) : (
        <img
          class="block h-7 w-auto max-w-[min(340px,45vw)] max-[950px]:h-6 max-[641px]:h-7 max-[641px]:max-w-[62vw]"
          src={site.logo}
          alt={site.name}
          width="556"
          height="88"
        />
      )
    }
  </a>

  {
    /* Home only. One stroked path, drawn by src/scripts/nav.ts from the
       wordmark's real position: the lockup's curved underline on landing,
       morphing into the bar's full-width rule as the nav assembles. */
    assemble && (
      <svg class="site-nav__underline" aria-hidden="true">
        <path fill="none" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }

  {
    variant !== 'minimal' && (
      <a
        class="site-nav__cta btn h-9 px-[18px] text-[14px] max-[641px]:hidden"
        href={site.cta.href}
      >
        {site.cta.label}
      </a>
    )
  }
</header>

<style>
  /* --nav-t: 0 = bare landing state, 1 = assembled bar.
     Defaults to 1 so the nav is complete and usable if the script never runs.
     Everything below interpolates off it, so it stays in CSS: the value is
     written by src/scripts/nav.ts on every scroll frame. */
  .site-nav { --nav-t: 1; }
  .site-nav::before,
  .site-nav::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }
  /* background fill */
  .site-nav::before {
    inset: 0;
    background: var(--page-bg);
    opacity: var(--nav-t);
  }
  /* hairline rule - draws outward from under the logo rather than fading */
  .site-nav::after {
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: var(--rule);
    transform: scaleX(var(--nav-t));
    transform-origin: 50% 50%;
  }

  /* ---- assemble-on-scroll (home only) ---- */
  /* interpolates from the open landing height down to --header-h, so the
     assembled bar always matches the height every other page uses at this
     breakpoint instead of a hardcoded 60px. */
  .site-nav--assemble {
    --nav-h-open: 96px;
    height: calc(var(--nav-h-open) - (var(--nav-h-open) - var(--header-h)) * var(--nav-t));
  }
  .site-nav--assemble .site-nav__logo :is(img, svg) { height: calc(40px - 12px * var(--nav-t)); }
  .site-nav--assemble .site-nav__links {
    opacity: var(--nav-t);
    transform: translateX(calc(-16px * (1 - var(--nav-t))));
  }
  /* the CTA is deliberately exempt from the scrub - it stays visible and
     clickable at every scroll position, including the bare landing state */
  /* nothing invisible should be clickable */
  .site-nav--assemble.is-bare .site-nav__links { pointer-events: none; }
  /* keyboard users tabbing in get the assembled bar immediately */
  .site-nav--assemble:focus-within { --nav-t: 1 !important; }

  /* ---- the underline (home only) ----
     Geometry, stroke width and colour are all written by nav.ts, so it works
     the same in every browser. It is the bar's rule as well: once the script
     has drawn it (`.has-underline`) the CSS hairline is switched off, so there
     is exactly one line at any scroll position. Without the script the CSS
     hairline stays as the fallback. */
  .site-nav__underline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .site-nav.has-underline::after { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .site-nav--assemble { --nav-t: 1 !important; }
  }

  @media (max-width: 640px) {
    .site-nav--assemble .site-nav__logo :is(img, svg) { height: calc(34px - 6px * var(--nav-t)); }
  }
</style>
