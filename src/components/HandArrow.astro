---
/**
 * Hand-drawn arrows extracted from the Framer "Handy Arrows" component
 * (src/data/arrows.json). Colour follows `currentColor`.
 */
import arrows from '@/data/arrows.json';

interface Props {
  name?: keyof typeof arrows;
  class?: string;
  style?: string;
  width?: number | string;
}
const { name = 'Arrow6', class: className, style, width, ...rest } = Astro.props;
const a = (arrows as Record<string, { w: string; h: string; viewBox: string; paths: Record<string, string>[] }>)[name];
const w = width ?? a.w;
---

<svg
  {...rest}
  class:list={['hand-arrow', className]}
  width={w}
  viewBox={a.viewBox}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style={style}
  aria-hidden="true"
>
  {a.paths.map((p) => <path {...p} />)}
</svg>

<style>
  .hand-arrow { height: auto; color: inherit; display: block; }
</style>
