---
/**
 * Hand-drawn arrows extracted from the Framer "Handy Arrows" component
 * (src/data/arrows.json). Colour follows `currentColor`.
 */
import arrows from '@/data/arrows.json';

interface Props {
  name?: keyof typeof arrows;
  class?: string;
  style?: string;
  width?: number | string;
}
const { name = 'Arrow6', class: className, style, width, ...rest } = Astro.props;
const a = (arrows as Record<string, { w: string; h: string; viewBox: string; paths: Record<string, string>[] }>)[name];
const w = width ?? a.w;
---

<svg
  {...rest}
  class:list={['hand-arrow', 'block h-auto', className]}
  width={w}
  viewBox={a.viewBox}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  style={style}
  aria-hidden="true"
>
  {a.paths.map((p) => <path {...p} />)}
</svg>

<style>
  /* KEPT deliberately. `color: inherit` here is unlayered, so it beats any
     `text-*` utility placed on the component - callers colour the arrow with
     unlayered scoped CSS instead (see digits-assignment.astro's
     `:global(.tricky__arrow)`, WhereIveBeen's `.where__arrow`,
     Footer's `.footer__tag :global(.atag__arrow)`). Turning it into a utility
     would flip that cascade for every caller. */
  .hand-arrow { color: inherit; }
</style>
