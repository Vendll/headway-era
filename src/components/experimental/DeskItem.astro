---
/**
 * One sticker on the experimental "desk": a 120px square sitting at the end of a
 * spoke of the (invisible) wheel the live Framer page arranges everything on.
 *
 *   <DeskItem href="/about" angle={0} label="About"><img … /></DeskItem>
 *
 * angle – degrees clockwise from the top of the wheel (the item is tilted by the same amount)
 * href  – omit for a purely decorative sticker (e.g. the Company Name wordmark)
 * The page script makes every item draggable via --dx / --dy; a click without a drag follows the link.
 */
interface Props {
  href?: string;
  angle: number;
  label?: string;
  class?: string;
}
const { href, angle, label, class: className } = Astro.props;
const external = !!href && /^https?:\/\//.test(href);
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={[
    'desk-item absolute left-1/2 top-[var(--cy)] w-[var(--s)] h-[var(--s)] cursor-grab will-change-transform',
    'touch-none select-none [-webkit-user-select:none] [-webkit-user-drag:none] [-webkit-tap-highlight-color:transparent]',
    'focus-visible:outline-2 focus-visible:outline-green focus-visible:outline-offset-4',
    { 'desk-item--link': !!href },
    className,
  ]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  aria-label={href ? label : undefined}
  style={`--a:${angle}deg`}
  data-desk-item
  draggable="false"
>
  <span class="desk-item__box relative block w-full h-full overflow-clip pointer-events-none [background:var(--box-bg,transparent)] [border-radius:var(--box-radius,0)] [transform:scale(1)] [transition:transform_0.4s_var(--ease-spring),box-shadow_0.3s_ease]"><slot /></span>
</Tag>

<style>
  /* ---------------------------------------------------------------------------
     Everything else is Tailwind utilities on the markup. What is left here
     cannot be expressed as a utility — see the note on each rule.
     ------------------------------------------------------------------------ */

  /* --dx/--dy are written by the page script, --a arrives through the inline
     `style`: the transform that reads them stays as CSS.
     drag offset (screen space) → centre on the wheel hub → walk out along the spoke */
  .desk-item {
    --dx: 0px;
    --dy: 0px;
    transform: translate(var(--dx), var(--dy)) translate(-50%, -50%) rotate(var(--a)) translateY(calc(-1 * var(--r)));
  }

  /* JS-toggled state class, on compound and descendant selectors. These also
     have to stay unlayered so they win over the box's own transform utility —
     @layer utilities always loses to unlayered CSS.
     The hover/drag scale lives on the inner box so the sticker grows in place
     (scaling the outer element would also scale its spoke offset and push it
     outwards). */
  .desk-item.is-dragging { cursor: grabbing; }
  .desk-item:hover .desk-item__box { transform: scale(1.08); }
  .desk-item.is-dragging .desk-item__box { transform: scale(1.08); box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45); }

  /* :global() onto whatever is slotted in. Converting it would push these
     utilities onto every caller's own <img>/<video> — i.e. into the component's
     API — and the .item-gemini override on /experimental has to be able to beat
     it, which a utility could not do. */
  .desk-item__box :global(img),
  .desk-item__box :global(video) {
    display: block;
    width: 102%;
    height: 102%;
    max-width: none;
    object-fit: cover;
    object-position: var(--media-pos, 50% 50%);
    -webkit-user-drag: none;
  }

  /* phones: the wheel becomes a full ring (angles doubled) but each sticker keeps its own tilt */
  @media (max-width: 949px) {
    .desk-item {
      transform: translate(var(--dx), var(--dy)) translate(-50%, -50%) rotate(calc(var(--a) * 2)) translateY(calc(-1 * var(--r))) rotate(calc(-1 * var(--a)));
    }
  }
</style>
