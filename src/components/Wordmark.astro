---
/**
 * The wordmark as inline SVG: the flat logo's seven glyph outlines, each in
 * its own `.wm__glyph` group so a script can place the letters on the
 * lockup's arc (home landing state) and ease them back to the flat baseline.
 * Untouched, it renders exactly like /assets/logo.svg.
 */
interface Props {
  class?: string;
}
const { class: className, ...rest } = Astro.props;
