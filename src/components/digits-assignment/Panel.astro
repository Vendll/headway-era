---
/**
 * Rounded media container used throughout the Project Six scroll story.
 *
 *   grey  – #fafafa, radius 20, padding 50 (landscape videos / dashboard screenshot)
 *   phone – white, 1px border, fixed 552px height, phone video top-aligned and clipped at the bottom
 *   plain – #fafafa, fixed 552px height, media centred (watch image)
 *
 * Media classes: `media--phone` for portrait phone recordings, `media--watch`
 * for the watch image.
 */
interface Props {
  variant?: 'grey' | 'phone' | 'plain';
  class?: string;
}
const { variant = 'grey', class: className } = Astro.props;

/* Variant utilities are picked here rather than stacked on the element: phone
   overrides the shared height/padding/justify-content, and two competing
   utilities for one property resolve by stylesheet order, not markup order. */
const variantClass = {
  grey: 'justify-center bg-[#fafafa] p-[50px] max-[950px]:p-[16px]',
  phone:
    'justify-start bg-white border border-[#dedede] h-[552px] pt-[100px] px-[20px] pb-[20px] max-[950px]:h-auto max-[950px]:pt-[32px] max-[950px]:px-[16px] max-[950px]:pb-0',
  plain: 'justify-center bg-[#fafafa] h-[552px] p-[20px] max-[950px]:h-auto max-[950px]:py-[40px] max-[950px]:px-[16px]',
}[variant];
---

<figure
  class:list={[
    'panel', `panel--${variant}`,
    'relative w-full flex flex-col items-center overflow-hidden rounded-[20px] max-[950px]:rounded-md',
    variantClass,
    className,
  ]}
  data-reveal="up"
  data-fade
>
  <slot />
</figure>

<style>
  /* Slot content — the media elements are authored in the page, so these
     :global rules have no markup in this component to move onto. */
  .panel :global(.media) { display: block; max-width: 100%; height: auto; }
  .panel--grey :global(.media) { width: 100%; border-radius: 12px; }
  .panel--phone :global(.media--phone) { width: 297px; border-radius: 30px; flex: none; }
  .panel--plain :global(.media--watch) { width: 270px; }

  @media (max-width: 949px) {
    .panel--grey :global(.media) { border-radius: 8px; }
    .panel--phone :global(.media--phone) { width: min(297px, 72%); max-height: 480px; object-fit: cover; object-position: top; border-radius: 22px 22px 0 0; }
    .panel--plain :global(.media--watch) { width: min(270px, 60%); }
  }
</style>
