---
/**
 * A pinned centred headline that splits apart (the first half slides left,
 * the second half slides right) once the paintings
 * start scrolling in underneath. Each painting sits in a 400 × 400 sticky slot
 * (top: 200px) so they stack on top of each other; the card inside tilts/scales
 * in (scale 1.4, rotateX −40°) as its slot travels up to the pinned position.
 *
 * The card's tilt/scale/opacity start state is applied inline by the script below.
 *
 * The painting's `rounded-[4px]!` is important because global.css has an UNLAYERED
 * `main :is(img, video, iframe) { border-radius: var(--radius-md) }`, and utilities
 * live in @layer utilities — a plain `rounded-[4px]` would lose to it.
 */
import type { Painting } from './types';

interface Props {
  paintings: Painting[];
  class?: string;
  id?: string;
}
const { paintings, class: className, id } = Astro.props;
---

<section id={id} class:list={['paint relative w-full flex flex-col items-center overflow-clip', className]} data-paint aria-label="Placeholder images">
  <div
    class="paint__pin sticky top-0 z-[9] w-full h-svh pointer-events-none grid place-items-center [--split:238px] max-[810px]:[--split:clamp(96px,17vw,238px)]"
    data-paint-pin
  >
    <h2 class="paint__line flex items-center justify-center gap-[4px] w-full font-body text-[16px] leading-[1.2] font-normal tracking-[-0.02em] text-line m-0">
      <span class="paint__a block w-[86px] flex-none whitespace-nowrap text-right transition-[transform] duration-[900ms] ease-spring will-change-transform">Sed, ut lorem</span>
      {' '}
      <span class="paint__b block w-[86px] flex-none whitespace-nowrap text-left transition-[transform] duration-[900ms] ease-spring will-change-transform">Et ipsum sit!</span>
    </h2>
  </div>

  <div class="paint__stack relative w-full flex flex-col items-center gap-[250px] pt-[1000px] pb-[180px] max-[1300px]:pb-[150px] max-[810px]:gap-[160px] max-[810px]:pt-[700px] max-[810px]:pb-[120px]">
    <span
      class="paint__trigger absolute top-[700px] left-0 w-full h-px pointer-events-none max-[810px]:top-[450px]"
      data-paint-trigger
      aria-hidden="true"></span>
    {
      paintings.map((p, i) => (
        <div
          class="paint__slot sticky top-[200px] w-[400px] h-[400px] max-w-[calc(100%_-_48px)] max-[810px]:top-[120px] max-[810px]:w-[min(400px,100%_-_48px)] max-[810px]:h-auto max-[810px]:aspect-square"
          data-paint-slot
          style={`--i:${i}`}
        >
          <figure
            class="paint__card w-full h-full rounded-[4px] grid place-items-center will-change-[transform,opacity] origin-center"
            data-paint-card
            style={`--size:${p.size ?? 0.885};--tilt:${p.tilt ?? -40}`}
          >
            <img
              src={p.src}
              alt={p.alt}
              width={p.width}
              height={p.height}
              loading="lazy"
              decoding="async"
              class="w-[calc(var(--size)*100%)] h-auto rounded-[4px]! object-cover"
              style={`aspect-ratio:${p.width} / ${p.height}`}
            />
          </figure>
        </div>
      ))
    }
  </div>
</section>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-paint]');
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 2);

  for (const section of sections) {
    const pin = section.querySelector<HTMLElement>('[data-paint-pin]');
    const trigger = section.querySelector<HTMLElement>('[data-paint-trigger]');
    const slots = Array.from(section.querySelectorAll<HTMLElement>('[data-paint-slot]'));
    const cards = slots.map((s) => s.querySelector<HTMLElement>('[data-paint-card]')!).filter(Boolean);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!cards.length) continue;

    const tilts = cards.map((c) => Number(getComputedStyle(c).getPropertyValue('--tilt')) || -40);
    const stickyTop = () => (window.innerWidth < 810 ? 120 : 200);

    // t = this card's own arrival progress; next = the following card's progress (fades this one out)
    const render = (card: HTMLElement, t: number, tilt: number, next = 0) => {
      const e = easeOut(t);
      const s = 1.4 - 0.4 * e;
      const rx = tilt * (1 - e);
      card.style.transform = `perspective(1200px) scale(${s.toFixed(4)}) rotateX(${rx.toFixed(2)}deg)`;
      const fadeIn = clamp01(t / 0.45);
      const fadeOut = 1 - clamp01((next - 0.45) / 0.4);
      card.style.opacity = Math.min(fadeIn, fadeOut).toFixed(3);
    };

    if (reduce) {
      pin?.classList.add('is-split');
      cards.forEach((c, i) => render(c, 1, tilts[i], i < cards.length - 1 ? 1 : 0));
      continue;
    }

    const update = () => {
      const vh = window.innerHeight;
      const top = stickyTop();
      // 1. split the line once the trigger (700px into the stack) has scrolled into / past the viewport
      if (pin && trigger) pin.classList.toggle('is-split', trigger.getBoundingClientRect().top < vh);
      // 2. tilt/scale each card in as its (untransformed) slot travels up to the sticky offset
      const ts = slots.map((slot) => clamp01((vh - slot.getBoundingClientRect().top) / (vh - top)));
      ts.forEach((t, i) => render(cards[i], t, tilts[i], ts[i + 1] ?? 0));
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<style>
  /* Everything below is KEPT deliberately — see the migration contract.

     `--i` is a per-slot custom property written inline in the markup, and the
     `.is-split` rules are compound state-class selectors toggled by the script
     that read the `--split` custom property set by the utility on the pin. */

  .paint__slot { z-index: calc(1 + var(--i)); }

  .paint__pin.is-split .paint__a { transform: translateX(calc(-1 * var(--split))); }
  .paint__pin.is-split .paint__b { transform: translateX(var(--split)); }
</style>
