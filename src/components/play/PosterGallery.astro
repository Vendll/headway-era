---
/**
 * Scroll-driven poster gallery (the /play signature animation).
 *
 * A tall wrapper pins a 100vh box. As the user scrolls through the wrapper the
 * posters travel from scattered, 3D-rotated, faded start positions into a neat
 * 4 × 2 grid (220 × 310 slots, 8px gap, column-first order like the Framer
 * `flex-flow: column wrap` original).
 *
 * `--pw` / `--ph` / `--pgap` are set on the section (and re-set per breakpoint)
 * and read by the grid and the posters. Each poster's start state is applied
 * inline by the script; without JS the grid simply shows.
 */
import type { Poster } from './types';

interface Props {
  posters: Poster[];
  class?: string;
  label?: string;
}
const { posters, class: className, label = 'Placeholder gallery' } = Astro.props;
---

<section
  class:list={[
    'gallery relative w-full h-[400vh] pt-[40px] [--pw:220px] [--ph:310px] [--pgap:8px] max-[1440px]:[--pw:186px] max-[1440px]:[--ph:261px] max-[1300px]:[--pw:149px] max-[1300px]:[--ph:203px] max-[1300px]:h-[300vh] max-[810px]:[--pw:min(150px,44vw)] max-[810px]:[--ph:calc(var(--pw)*1.42)] max-[810px]:[--pgap:8px] max-[810px]:h-[300vh] max-[481px]:[--pw:min(110px,28vw)] max-[481px]:[--ph:calc(var(--pw)*1.42)]',
    className,
  ]}
  data-gallery
  aria-label={label}
>
  <div class="gallery__pin sticky top-0 h-svh w-full max-w-[1480px] mx-auto grid place-items-center overflow-hidden perspective-[800px] perspective-origin-center">
    <ul
      class="gallery__grid list-none grid grid-flow-col grid-rows-[repeat(2,var(--ph))] auto-cols-[var(--pw)] gap-[var(--pgap)] transform-3d px-[30px] max-[810px]:grid-flow-row max-[810px]:grid-rows-none max-[810px]:grid-cols-[repeat(2,var(--pw))] max-[810px]:auto-cols-auto max-[810px]:px-[20px] max-[481px]:flex max-[481px]:flex-wrap max-[481px]:justify-center max-[481px]:max-w-[calc(3*var(--pw)_+_2*var(--pgap)_+_40px)]"
      data-gallery-grid
    >
      {
        posters.map((p, i) => (
          <li
            class="poster relative w-[var(--pw)] h-[var(--ph)] transform-3d will-change-[transform,opacity] backface-hidden cursor-pointer"
            data-poster
            style={`--i:${i};--fx:${p.from.x};--fy:${p.from.y};--fs:${p.from.s};--frz:${p.from.rz ?? 0};--frx:${p.from.rx ?? 0};--fry:${p.from.ry ?? 0}`}
          >
            <img
              src={p.src}
              alt={p.alt}
              width={p.width}
              height={p.height}
              loading="eager"
              decoding="async"
              draggable="false"
              class="w-full h-full object-cover object-center select-none [-webkit-user-drag:none]"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Maps scroll progress through the tall wrapper (0 → 1) onto each poster's
  // transform, interpolating from its scattered start state to its grid slot.
  const sections = document.querySelectorAll<HTMLElement>('[data-gallery]');

  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const smooth = (t: number) => t * t * (3 - 2 * t);

  for (const section of sections) {
    const posters = Array.from(section.querySelectorAll<HTMLElement>('[data-poster]'));
    if (!posters.length) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Start = { x: number; y: number; s: number; rz: number; rx: number; ry: number };
    const starts: Start[] = posters.map((el) => {
      const cs = getComputedStyle(el);
      const n = (name: string) => Number(cs.getPropertyValue(name)) || 0;
      return { x: n('--fx'), y: n('--fy'), s: n('--fs') || 0.3, rz: n('--frz'), rx: n('--frx'), ry: n('--fry') };
    });

    // The grid is fully assembled by 80% of the pinned scroll so it sits still
    // for a beat before the section unpins (matches the live site).
    const SETTLE = 0.8;

    let last = -1;
    const render = (progress: number) => {
      if (progress === last) return;
      last = progress;
      const k = Math.min(1, Math.max(0.35, window.innerWidth / 1440)); // shrink the scatter on small screens
      posters.forEach((el, i) => {
        const st = starts[i];
        const delay = i * 0.035;
        const local = clamp01((progress - delay) / (SETTLE - delay));
        const t = easeOut(local);
        const o = smooth(clamp01(local / 0.7));
        const x = st.x * k * (1 - t);
        const y = st.y * k * (1 - t);
        const s = st.s + (1 - st.s) * t;
        const rz = st.rz * (1 - t);
        const rx = st.rx * (1 - t);
        const ry = st.ry * (1 - t);
        el.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${s.toFixed(4)}) rotateZ(${rz.toFixed(2)}deg) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
        el.style.opacity = o.toFixed(3);
      });
      section.classList.toggle('is-settled', progress >= SETTLE);
    };

    if (reduce) {
      section.classList.add('is-static');
      render(1);
      continue;
    }

    const update = () => {
      const r = section.getBoundingClientRect();
      const range = r.height - window.innerHeight;
      const p = range > 0 ? clamp01(-r.top / range) : 1;
      render(p);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      last = -1;
      update();
    });
  }
</script>

<style>
  /* Everything below is KEPT deliberately — see the migration contract.
     All four rules are compound state-class selectors (`.is-static` /
     `.is-settled` are toggled by the script above), and the hover transform
     has to stay `!important` to beat the inline transform the script writes. */

  /* reduced-motion fallback: no pin, no 400vh scroll runway */
  .gallery.is-static { height: auto; padding: 80px 0; }
  .gallery.is-static .gallery__pin { position: static; height: auto; overflow: visible; }

  /* hover lift, only once the grid has assembled */
  .gallery.is-settled .poster { transition: transform 0.4s var(--ease-spring); }
  .gallery.is-settled .poster:hover { transform: translate3d(0, -6px, 0) scale(1.03) !important; z-index: 2; }
</style>
