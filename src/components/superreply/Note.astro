---
/**
 * Project One — annotation placed on top of a figure: dotted purple leader line ending in a dot,
 * plus a small note (text, and optionally a list). Positioned absolutely inside a `position: relative` box.
 *
 *   <Note top={311} left={825} line={72} width={170}>Lorem ipsum dolor sit<ul><li>…</li></ul></Note>
 *   <Note vertical top={42} left={313} line={30} width={225}>…</Note>   (text above, line going down)
 *   <Note side="left" …>…</Note>                                         (text on the left of the line)
 *
 * Hidden below 950px (the figures collapse to plain images there).
 */
interface Props {
  top: number | string;
  left: number | string;
  /** leader-line length (px) */
  line?: number;
  /** text width (px) */
  width?: number;
  side?: 'left' | 'right';
  vertical?: boolean;
  /** vertical only: x-offset (px) of the line from the text's left edge */
  lineOffset?: number;
  class?: string;
}
const { top, left, line = 80, width = 170, side = 'right', vertical = false, lineOffset = 30, class: className, ...rest } = Astro.props;
const px = (v: number | string) => (typeof v === 'number' ? `${v}px` : v);
---

<div {...rest} class:list={['note', `note--${side}`, { 'note--v': vertical }, className]} style={`top:${px(top)};left:${px(left)};--line:${line}px;--w:${width}px;--line-x:${lineOffset}px`}>
  <span class="note__line" aria-hidden="true"></span>
  <div class="note__text"><slot /></div>
</div>

<style>
  .note {
    position: absolute;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    z-index: 2;
    pointer-events: none;
    --c: #8d01ff;
  }
  .note--left { flex-direction: row-reverse; transform: translateX(-100%); }
  .note__line {
    position: relative;
    flex: none;
    width: var(--line);
    height: 0;
    margin-top: 7px;
    border-top: 2px dotted var(--c);
    opacity: 0.85;
  }
  /* dot at the text end of the line */
  .note__line::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .note--right .note__line::after { right: -3px; }
  .note--left .note__line::after { left: -3px; }

  .note__text {
    width: var(--w);
    font-size: 12px;
    line-height: 1.25;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #5b5b5b;
  }
  .note__text :global(p + p) { margin-top: 1em; }
  .note__text :global(strong) { font-weight: 500; color: #262626; }
  .note__text :global(ul) { list-style: disc; padding-left: 1.1em; margin-top: 4px; }
  .note__text :global(li) { margin: 0; }

  /* vertical: text above, line going down, dot at the far (bottom) end */
  .note--v { flex-direction: column-reverse; align-items: flex-start; gap: 6px; }
  .note--v .note__line {
    width: 0;
    height: var(--line);
    margin: 0 0 0 var(--line-x, 30px);
    border-top: 0;
    border-left: 2px dotted var(--c);
  }
  .note--v .note__line::after { top: auto; bottom: -3px; left: -4px; right: auto; }

  /* the figures re-flow below 1200px, so pixel-positioned notes are hidden there */
  @media (max-width: 1199px) {
    .note { display: none; }
  }
</style>
