---
/**
 * Project One — annotation placed on top of a figure: dotted purple leader line ending in a dot,
 * plus a small note (text, and optionally a list). Positioned absolutely inside a `position: relative` box.
 *
 *   <Note top={311} left={825} line={72} width={170}>Lorem ipsum dolor sit<ul><li>…</li></ul></Note>
 *   <Note vertical top={42} left={313} line={30} width={225}>…</Note>   (text above, line going down)
 *   <Note side="left" …>…</Note>                                         (text on the left of the line)
 *
 * Hidden below 950px (the figures collapse to plain images there).
 */
interface Props {
  top: number | string;
  left: number | string;
  /** leader-line length (px) */
  line?: number;
  /** text width (px) */
  width?: number;
  side?: 'left' | 'right';
  vertical?: boolean;
  /** vertical only: x-offset (px) of the line from the text's left edge */
  lineOffset?: number;
  class?: string;
}
const { top, left, line = 80, width = 170, side = 'right', vertical = false, lineOffset = 30, class: className, ...rest } = Astro.props;
const px = (v: number | string) => (typeof v === 'number' ? `${v}px` : v);

/* flex-direction / transform are emitted exclusively so the vertical variant keeps
   winning over the left variant, exactly as the old cascade did. */
const dir = vertical ? 'flex-col-reverse' : side === 'left' ? 'flex-row-reverse' : '';
const shift = side === 'left' ? '-translate-x-full' : '';
const gap = vertical ? 'gap-[6px]' : 'gap-[10px]';

/* vertical: the line runs downwards from the text and the dot sits at its far end */
const lineClass = vertical
  ? 'relative flex-none w-0 h-[var(--line)] ml-[var(--line-x,30px)] border-l-2 border-dotted border-purple opacity-85'
  : 'relative flex-none w-[var(--line)] h-0 mt-[7px] border-t-2 border-dotted border-purple opacity-85';
---

<div
  {...rest}
  class:list={[
    'note',
    `note--${side}`,
    { 'note--v': vertical },
    'absolute flex items-start z-[2] pointer-events-none',
    gap,
    dir,
    shift,
    'max-[1200px]:hidden',
    className,
  ]}
  style={`top:${px(top)};left:${px(left)};--line:${line}px;--w:${width}px;--line-x:${lineOffset}px;--c:#8d01ff`}
>
  <span class:list={['note__line', lineClass]} aria-hidden="true"></span>
  <div class="note__text w-[var(--w)] text-[12px] leading-[1.25] font-normal tracking-[-0.01em] text-muted-2"><slot /></div>
</div>

<style>
  /* dot at the text end of the line */
  .note__line::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .note--right .note__line::after { right: -3px; }
  .note--left .note__line::after { left: -3px; }
  /* vertical: dot at the far (bottom) end */
  .note--v .note__line::after { top: auto; bottom: -3px; left: -4px; right: auto; }

  /* slotted content — owned by the caller's markup, so it stays as :global() CSS */
  .note__text :global(p + p) { margin-top: 1em; }
  .note__text :global(strong) { font-weight: 500; color: #262626; }
  .note__text :global(ul) { list-style: disc; padding-left: 1.1em; margin-top: 4px; }
  .note__text :global(li) { margin: 0; }
</style>
