---
/**
 * Project One — the product dashboard ("Hello, User!") rebuilt in HTML/CSS.
 * On the Framer page this is a live component (text + SVGs), not an image, so it is recreated here
 * at its original size (756 × 618) and scaled down with `zoom` on small screens.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const stats = [
  { label: 'Metric One', value: '100k', sub: '↑ 50,000', up: true },
  { label: 'Metric Two', value: '1560', sub: '76%' },
  { label: 'Total Metric Three', value: '35', sub: '100%' },
  { label: 'Metric Four', value: '-', sub: 'Lorem ipsum dolor on 01-01-2024' },
];
const yLabels = ['50k', '10k', '1k', '500', '100', '0'];
const days = ['19 Aug', '20 Aug', '21 Aug', '22 Aug', '23 Aug', '24 Aug', '25 Aug'];
const points = [
  [0, 133.75],
  [89, 69.5],
  [179, 102.5],
  [269, 77.5],
  [314, 54],
  [359, 30.5],
  [449, 80.75],
  [539.25, 0],
];
const linePath = points.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
const areaPath = `${linePath} L539.25 136 L0 136 Z`;

/* the pill-shaped "Today" / "Last 7 days" dropdown, and its chevron glyph */
const select =
  'dash__select inline-flex items-center justify-between gap-[6px] h-[15px] w-[79px] px-[6px] py-0 border border-line rounded-[3px] text-[6px] text-[#303030] bg-white flex-none';
const caret = 'w-[4px] h-[4px] border-r border-b border-[#747376] [transform:translateY(-1px)_rotate(45deg)]';
/* the two <svg> chart layers share a box */
const plotLayer = 'absolute left-[40px] right-0 top-0 w-[calc(100%_-_40px)] h-[150px] block';
---

<div
  class:list={[
    'dash',
    'relative w-[756px] h-[618px] bg-white rounded-[8px] shadow-[0_2px_24px_rgba(0,0,0,0.06)] overflow-hidden font-body text-ink tracking-[-0.01em] flex-none',
    'max-[950px]:[zoom:0.72] max-[641px]:[zoom:0.52] max-[461px]:[zoom:0.42]',
    className,
  ]}
  role="img"
  aria-label="Project One dashboard: greeting, placeholder-style profile card for username, four metric cards (Metric One 100k, Metric Two 1560, Total Metric Three 35, Metric Four), and an Activity runs line chart for the last 7 days"
>
  <img class="dash__side absolute left-0 top-0 w-[38px] h-auto border-r border-r-[#ececec]" src="/assets/images/9usSOhlYHbfJVZfCPLmNDwyQhNo.png" alt="" width="118" height="1820" loading="lazy" decoding="async" />

  <div class="dash__top absolute left-[38px] right-0 top-0 h-[36px] flex items-center justify-between py-0 pr-[10px] pl-[18px] border-b border-b-[#f0f0f0]">
    <span class="dash__crumb text-[8px] font-medium">Dashboard</span>
    <span class="dash__new inline-flex items-center gap-[4px] h-[15px] px-[8px] py-0 bg-purple text-white rounded-[3px] text-[6px] font-medium"><i class="not-italic text-[8px] leading-none" aria-hidden="true">+</i> New Action</span>
  </div>

  <div class="dash__main absolute left-[38px] right-0 top-0 pt-[60px] pr-[12px] pb-0 pl-[18px]">
    <p class="dash__hello text-[16px] font-semibold tracking-[-0.02em]">Hello, User! <span aria-hidden="true">👋</span></p>

    <div class="dash__profile relative flex items-start gap-[16px] pb-[14px] border-b border-b-[#ececec]">
      <img class="dash__avatar w-[86px] h-[86px] rounded-[50%] flex-none" src="/assets/images/VreHDGKPtkt7nIODurr3FzA8.png" alt="" width="356" height="356" loading="lazy" decoding="async" />
      <div class="dash__who pt-[8px]">
        <p class="dash__handle flex items-center gap-[4px] text-[14px] font-semibold tracking-[-0.02em]">
          username
          <img class="w-[10px] h-[10px]" src="/assets/images/ER6VjEzofV7zjwNHk5HDlRqong.png" alt="" width="40" height="40" loading="lazy" decoding="async" />
          <span class="dash__more text-[10px] text-[#302e33] ml-[4px]" aria-hidden="true">⋮</span>
        </p>
        <p class="dash__name text-[8px]">Person Five</p>
        <p class="dash__counts text-[8px] text-[#59585c] [word-spacing:1px]"><b class="font-semibold text-ink">288</b> posts <b class="font-semibold text-ink">400k</b> followers <b class="font-semibold text-ink">1,890</b> following</p>
        <p class="dash__bio text-[8px]">lorem ipsum 🛸</p>
        <p class="dash__bio text-[8px] mt-[2px]">dolor sit. Lorem &amp; Ipsum @user123</p>
      </div>
      <span class:list={[select, 'dash__select--today absolute right-0 bottom-[14px]']}>Today <i class={caret} aria-hidden="true"></i></span>
    </div>

    <div class="dash__cards grid grid-cols-4 gap-[23px] mt-[10px]">
      {
        stats.map((s) => (
          <div class="dash__card h-[85px] px-[12px] pt-[12px] pb-[10px] border border-[#e6e6e6] rounded-[4px] flex flex-col">
            <p class="dash__card-label flex items-center gap-[4px] text-[7px] text-[#303030]">
              <svg width="8" height="8" viewBox="-1 -1 10 10" fill="none" aria-hidden="true"><path d="M0 .4v5c0 .1 0 .2.1.3l.3.1h2.9l2.1 1.7V5.8h1.7c.1 0 .2 0 .3-.1l.1-.3v-5c0-.1 0-.2-.1-.3L7.1 0H.4C.3 0 .2 0 .1.1L0 .4Z" stroke="#59585C" stroke-width=".75" stroke-linejoin="round"/></svg>
              {s.label}
            </p>
            <p class="dash__card-value text-[16px] font-semibold tracking-[-0.02em] text-center">{s.value}</p>
            <p class:list={['dash__card-sub', { 'is-up': s.up }, 'text-[6.5px] text-center', s.up ? 'text-[#6b9610]' : 'text-muted-2']}>{s.sub}</p>
          </div>
        ))
      }
    </div>

    <div class="dash__runs flex items-end justify-between mt-[16px]">
      <span class="dash__runs-h text-[8px] font-semibold">Activity runs</span>
      <span class={select}>Last 7 days <i class={caret} aria-hidden="true"></i></span>
    </div>

    <div class="dash__chart relative mt-[8px] h-[229px] border border-[#e6e6e6] rounded-[4px] px-[16px] pt-[12px] pb-0">
      <p class="dash__total text-[7px] text-[#303030] text-center">Total runs <b class="font-semibold">11</b></p>
      <div class="dash__plot relative mt-[12px] h-[176px] pl-[40px]">
        <div class="dash__y absolute left-0 top-[-4px] w-[30px] h-[154px] flex flex-col justify-between items-end text-[6px] text-[#747376]">{yLabels.map((l) => <span>{l}</span>)}</div>
        <svg class:list={['dash__line', plotLayer]} viewBox="-1 -4 542 141" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="sr-dash-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8d01ff" stop-opacity="0.28" />
              <stop offset="1" stop-color="#8d01ff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d={areaPath} fill="url(#sr-dash-fill)" />
          <path d={linePath} stroke="#C290FE" stroke-width="1.5" fill="none" vector-effect="non-scaling-stroke" />
        </svg>
        <svg class:list={['dash__dots', plotLayer, 'overflow-visible']} viewBox="-1 -4 542 141" preserveAspectRatio="none" aria-hidden="true">
          {points.map(([x, y]) => <circle cx={x} cy={y} r="2.4" fill="#8d01ff" />)}
        </svg>
        <div class="dash__x absolute left-[40px] right-0 top-[160px] flex justify-between text-[6px] text-[#747376]">
          {days.map((d, i) => <span class:list={['w-[24px]', i === 0 ? 'text-left' : i === days.length - 1 ? 'text-right' : 'text-center']}>{d}</span>)}
        </div>
      </div>
    </div>
  </div>
</div>
