---
/**
 * Case-study page shell: "← Back" + sticky table of contents on the left,
 * 1200px content column on the right, footer at the bottom.
 *
 * <CaseStudyLayout eyebrow="Project One" title="Lorem ipsum dolor <em>sit amet consectetur</em> …" tags="…" year="2024" toc={[{id:'introduction',label:'Introduction'}, …]}>
 *   <div slot="hero">…</div>
 *   …sections…
 * </CaseStudyLayout>
 */
import BaseLayout from './BaseLayout.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string; // HTML allowed (<em> for the italic part)
  pageTitle?: string;
  description?: string;
  eyebrow: string;
  tags: string;
  year: string;
  toc: { id: string; label: string }[];
  accent?: string;
  class?: string;
}
const { title, pageTitle, description, eyebrow, tags, year, toc, accent, class: className } = Astro.props;
const plainTitle = title.replace(/<[^>]+>/g, '');
---

<BaseLayout title={pageTitle ?? `${eyebrow} — Placeholder Name`} description={description ?? plainTitle} theme="light" header="default" bodyClass="is-case">
  <div
    class:list={[
      'cs',
      'grid grid-cols-[220px_1200px] justify-center gap-0 pt-[var(--header-h)]',
      'max-[1500px]:grid-cols-[200px_minmax(0,1fr)] max-[1500px]:px-6',
      'max-[1200px]:grid-cols-[1fr]',
      className,
    ]}
    style={accent ? `--accent-cs:${accent}` : undefined}
  >
    <aside class="cs__side relative max-[1200px]:hidden">
      <div class="cs__sticky sticky top-[calc(var(--header-h)_+_24px)] pt-10">
        <a class="cs__back inline-flex items-center gap-2 font-mono text-[16px] font-light tracking-[-0.04em] text-muted mb-[30px] transition-[color] duration-[200ms] ease-[ease] hover:text-ink" href="/">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
          Back
        </a>
        <nav class="cs__toc flex flex-col" aria-label="On this page">
          {toc.map((t) => <a class="font-mono text-[14px] leading-[1.4] font-light tracking-[-0.04em] text-muted py-[5.5px] px-0 whitespace-nowrap transition-[color] duration-[250ms] ease-[ease] hover:text-ink-2" href={`#${t.id}`} data-toc-link>{t.label}</a>)}
        </nav>
      </div>
    </aside>

    <article class="cs__body pt-[60px] px-[40px] pb-[80px] min-w-0 max-[1200px]:pt-[80px] max-[1200px]:px-0 max-[1200px]:pb-[60px]">
      <header class="cs__head mb-[30px]">
        <p class="cs__eyebrow font-mono text-[16px] font-light tracking-[-0.04em] text-muted mb-2" data-reveal>{eyebrow}</p>
        <h1 class="cs__title font-display font-normal text-[58px] leading-none tracking-[-0.02em] text-ink max-w-[900px] [@media(max-width:640px)]:text-[36px]" data-reveal data-reveal-delay="0.05" set:html={title} />
        <div class="cs__meta flex justify-between items-baseline gap-6 mt-10 [@media(max-width:640px)]:flex-col [@media(max-width:640px)]:gap-[6px]" data-reveal data-reveal-delay="0.1">
          <p class="cs__tags text-[16px] font-normal text-muted">{tags}</p>
          <p class="cs__year text-[16px] font-normal tracking-[-0.04em] text-ink-2">{year}</p>
        </div>
      </header>
      <slot name="hero" />
      <slot />
    </article>
  </div>
  <Footer />
</BaseLayout>

<style is:global>
@layer components {
    /* `.is-active` is toggled by the page's scrollspy script — a JS-driven state
       class with no utility equivalent. */
    .cs__toc a.is-active { color: var(--ink-2); }
    /* The <em> is injected via `set:html`, so it cannot carry a utility class. */
    .cs__title em { font-style: italic; }

    /* ---- shared case-study primitives ----
       These are the global API consumed by src/components/cs/* and the case-study
       pages (some of which reach in via `:global(.cs-row)`), so they stay here. */
    .cs-hero { width: 100%; min-height: 560px; display: grid; place-items: center; overflow: hidden; margin-bottom: 40px; border-radius: var(--r-lg); }
    .cs-hero > * { max-width: 100%; }

    .cs-label { font-family: var(--font-mono); font-size: 14px; line-height: 1.4; font-weight: 300; letter-spacing: -0.04em; color: var(--muted-2); }
    .cs-label--muted { color: var(--muted); }
    .cs-label--light { color: var(--muted); }
    .cs-h { font-size: 18px; line-height: 1.3; font-weight: 500; letter-spacing: -0.02em; color: var(--ink); }
    .cs-h--lg { font-size: 20px; }
    .cs-p, .cs-body p, .cs-body li { font-size: 16px; line-height: 1.3; font-weight: 300; letter-spacing: -0.02em; color: var(--muted-2); }
    .cs-body p + p { margin-top: 1.3em; }
    .cs-body strong { font-weight: 500; color: inherit; }
    .cs-body ul, .cs-body ol { padding-left: 1.2em; margin-top: 0.9em; }
    .cs-body li { margin: 0.35em 0; }
    .cs-body ul { list-style: disc; }
    .cs-body ol { list-style: decimal; }

    .cs-section { padding: 40px 0 0; scroll-margin-top: calc(var(--header-h) + 24px); }
    .cs-section + .cs-section { margin-top: 30px; }
    .cs-section > .cs-label { margin-bottom: 24px; }
    .cs-inner { width: 880px; max-width: 100%; margin-inline: auto; }

    .cs-row { display: grid; grid-template-columns: 292px 1fr; column-gap: 16px; padding: 22px 0; }
    .cs-row__body { max-width: 572px; }

    .cs-dark { background: var(--dark); color: #f5f5f5; width: 1008px; max-width: 100%; margin-inline: auto; padding: 50px 50px 80px; border-radius: var(--r-lg); }
    .cs-dark .cs-h, .cs-dark .cs-body p, .cs-dark .cs-body li { color: #e3e3e3; }
    .cs-dark .cs-h { color: #f5f5f5; }
    .cs-dark .cs-label { color: #969696; }

    .cs-figure { background: var(--bg-2); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; position: relative; border-radius: var(--r-md); }
    .cs-figure__caption { font-size: 14px; font-style: italic; font-weight: 300; color: var(--muted-2); text-align: center; margin-top: 18px; }

    .cs-grid { display: grid; gap: 16px; }
    .cs-card { padding: 24px; border-radius: var(--r-md); }
    .cs-card--dark { background: var(--dark); color: #f5f5f5; }
    .cs-card--dark .cs-card__title { color: #f5f5f5; }
    .cs-card--dark .cs-card__body p, .cs-card--dark .cs-card__body li { color: #e3e3e3; }
    .cs-card--grey { background: #262626; color: #f5f5f5; }
    .cs-card--grey .cs-card__title { color: #f5f5f5; }
    .cs-card--grey .cs-card__body p, .cs-card--grey .cs-card__body li { color: #f5f5f5; }
    .cs-card--light { background: var(--bg-2); }
    .cs-card--outline { background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); }

    @media (max-width: 1199px) {
      .cs-inner { width: 100%; }
      .cs-dark { width: 100%; padding: 32px 24px 40px; }
      .cs-row { grid-template-columns: 1fr; gap: 10px; }
      .cs-title { font-size: 44px; }
    }
    @media (max-width: 640px) {
      .cs-figure { padding: 16px; }
    }
}
</style>
